---
interface Props {
	word: string;
	label?: string;
	title: string;
	description: string;
	descriptionBelowTitle?: boolean;
	portrait?: string;
}

const { word, label, title, description, descriptionBelowTitle, portrait } = Astro.props;
---

<header class="container portfolio-intro">
	<div class="intro-art" aria-hidden="true">
		<span>{word}</span>
		{portrait && <img src={portrait} alt="" width="300" height="300" fetchpriority="high" />}
	</div>
	<div class="intro-columns">
		<div>
			<h1>{title}</h1>
			{label && <p class="portfolio-label intro-label">{label}</p>}
			{descriptionBelowTitle && <p class="intro-description">{description}</p>}
		</div>
		<div class="intro-support">
			{!descriptionBelowTitle && <p class="intro-description">{description}</p>}
			<slot />
		</div>
	</div>
</header>

<style>
	/* Compact header: page name, headline and description, so content shows on the first screen. */
	.portfolio-intro { padding-block: clamp(16px, 2.5vw, 32px) clamp(24px, 3vw, 40px); }
	.intro-art {
		display: flex;
		align-items: center;
		gap: 16px;
		color: var(--pink);
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -.03em;
	}
	.intro-art img {
		width: clamp(48px, 5vw, 72px);
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		object-position: center 20%;
		border-radius: 50%;
	}
	.intro-columns {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		align-items: end;
		gap: 12px 48px;
		padding-top: 14px;
	}
	.intro-columns h1 {
		margin: 0;
		font-size: clamp(1.5rem, 2.6vw, 2.25rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -.03em;
	}
	.intro-columns > div:first-child { display: flex; flex-direction: column; }
	.intro-label { order: -1; margin: 0 0 10px; }
	.intro-description { margin: 0; color: var(--secondary); font-size: 17px; }
	h1 ~ .intro-description { margin-top: 12px; }
	.intro-support { display: grid; gap: 16px; }
	.intro-support:empty { display: none; }
	@media (max-width: 720px) {
		.intro-columns { grid-template-columns: 1fr; gap: 12px; }
	}
</style>
