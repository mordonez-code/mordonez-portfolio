---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, personId, resources, site } from "../../data/site";
import { getJournalArticles } from "../../lib/journal.server";

export async function getStaticPaths() {
	const articles = await getJournalArticles();
	return articles.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const articles = await getJournalArticles();
const relatedResource = resources[articles.findIndex((item) => item.slug === article.slug) % resources.length];
const bodyIntro = article.bodyMarkdown
	?.replace(/^# .+\n+/, "")
	.split("## Key points")[0]
	.trim();

const pageUrl = `${site.url}/journal/${article.slug}/`;
const articleSchema = {
	"@type": "BlogPosting",
	"@id": `${pageUrl}#article`,
	headline: article.title,
	description: article.metaDescription ?? article.excerpt,
	url: pageUrl,
	mainEntityOfPage: pageUrl,
	articleSection: article.category,
	keywords: article.keyword,
	inLanguage: "en",
	...(article.publishedAt ? { datePublished: article.publishedAt } : {}),
	author: { "@id": personId },
	publisher: { "@id": personId },
};
---

<Layout
	title={`${article.title} - Journal`}
	description={article.metaDescription ?? article.excerpt}
	path={`/journal/${article.slug}/`}
	type="article"
	schema={[
		articleSchema,
		breadcrumbSchema([
			["Journal", "/journal/"],
			[article.title, `/journal/${article.slug}/`],
		]),
	]}
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>{article.keyword}</p>
			<h1 class="page-title">{article.title}</h1>
			<p class="page-lede">{article.excerpt}</p>
			<div class="pill-row">
				<span class="pill">{article.category}</span>
				<span class="pill">Portfolio note</span>
			</div>
		</section>

		<section class="container section tight detail-grid">
			<article class="prose">
				{bodyIntro && <p>{bodyIntro}</p>}

				<h2>What this note covers</h2>
				<ul>
					{article.outline.map((item) => <li>{item}</li>)}
				</ul>

				<p>
					<a class="text-link" href="/work/">See this thinking in the work</a> or email me for
					remote graphic, ecommerce and marketing design roles.
				</p>
			</article>

			<aside class="aside" aria-label="Article details">
				<dl>
					<dt>Category</dt>
					<dd>{article.category}</dd>
					<dt>Topic</dt>
					<dd>{article.keyword}</dd>
					<dt>Related resource</dt>
					<dd>{relatedResource.title}</dd>
					<dt>Contact</dt>
					<dd><a class="text-link" href={`mailto:${site.email}`}>Talk about a role</a></dd>
				</dl>
			</aside>
		</section>
	</main>
</Layout>
