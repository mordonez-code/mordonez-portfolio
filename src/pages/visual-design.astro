---
import ClosingBand from "../components/ClosingBand.astro";
import { packaging, playGallery, socialChannels, watercolors } from "../data/site";
import Layout from "../layouts/Layout.astro";

const featured = [
	"shiitake-mushroom", "bogota", "chemex", "nairo", "blossomed-heart", "la-raqueta",
	"calm-palm", "dog-portrait", "shiitake-pizza", "two-riders", "bbq-sauce", "line-figure",
	"casabianca-coral", "pepairegui",
];
const motionSlugs = ["oyster-tacos", "popsicle", "washing-dishes"];
const illustration = [
	...featured.flatMap((slug) => playGallery.filter((item) => item.slug === slug)),
	...playGallery.filter(({ slug }) => !featured.includes(slug) && !motionSlugs.includes(slug)),
];
const motion = motionSlugs.flatMap((slug) => playGallery.filter((item) => item.slug === slug));
const shop = "https://tienda.mordonez.com/";
---

<Layout
	title="Visual Design · Watercolour, Illustration, Motion & Packaging"
	description="Handmade watercolour, illustration, motion and packaging design by Mariana Ordoñez."
	path="/visual-design/"
>
	<main class="play-page">
		<header class="container vd-intro">
			<h1>Visual Design</h1>
			<p>Packaging, illustration, handmade watercolour and motion. The human craft behind the product and commerce work.</p>
		</header>

		<section class="container portfolio-section" aria-labelledby="packaging-title">
			<header class="play-split">
				<div>
					<p class="portfolio-label">01 · Packaging</p>
					<h2 id="packaging-title" class="portfolio-heading">Boxes, tins, pouches and wrappers.</h2>
				</div>
				<p>Packaging for food, tea, beauty and my own prints: one brand idea carried across every face of the pack.</p>
			</header>
			<div class="digital-wall wall-3">
				{packaging.map((item) => (
					<a class="gallery-item" href={`/play/${item.slug}.webp`} data-gallery-image>
						<img
							src={`/play/thumbs/${item.slug}.webp`}
							alt={item.alt}
							width={item.width}
							height={item.height}
							loading="lazy"
							decoding="async"
						/>
						<span class="watercolour-caption">{item.title}<span>{item.note}</span></span>
					</a>
				))}
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="illustration-title">
			<header class="play-split">
				<div>
					<p class="portfolio-label">02 · Illustration</p>
					<h2 id="illustration-title" class="portfolio-heading">Illustration, type and print.</h2>
				</div>
				<p>Posters, labels, recipes and portraits, drawn digitally for brands and for myself.</p>
			</header>
			<div class="digital-wall">
				{illustration.map((item) => (
					<a class="gallery-item" href={`/play/${item.slug}.webp`} data-gallery-image>
						<img
							src={`/play/thumbs/${item.slug}.webp`}
							alt={item.alt}
							width={item.width}
							height={item.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				))}
			</div>
		</section>

		<section class="portfolio-light watercolour-band" aria-labelledby="watercolour-title">
			<div class="container">
				<header class="play-split">
					<div>
						<p class="portfolio-label">03 · Handmade</p>
						<h2 id="watercolour-title" class="portfolio-heading">Painted by hand.</h2>
					</div>
					<p>Botanical studies in watercolour on paper. No undo, no layers. The analog end of the same curiosity.</p>
				</header>
				<div class="watercolour-grid">
					{watercolors.map((item, index) => (
						<a class="gallery-item" href={`/play/${item.slug}.webp`} data-gallery-image>
							<img
								src={`/play/thumbs/${item.slug}.webp`}
								alt={item.alt}
								width={item.width}
								height={item.height}
								loading="lazy"
								decoding="async"
							/>
							<span class="watercolour-caption" aria-hidden="true">
								{item.title}
								<span>{String(index + 1).padStart(2, "0")}</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="motion-title">
			<header class="play-split">
				<div>
					<p class="portfolio-label">04 · Motion</p>
					<h2 id="motion-title" class="portfolio-heading">Things that move.</h2>
				</div>
				<p>Animated type and illustration loops for social and the web.</p>
			</header>
			<div class="digital-wall wall-3">
				{motion.map((item) => (
					<a class="gallery-item" href={`/play/${item.slug}.webp`} data-gallery-image>
						<img
							src={`/play/thumbs/${item.slug}.webp`}
							alt={item.alt}
							width={item.width}
							height={item.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				))}
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="social-title">
			<header class="play-split">
				<div>
					<p class="portfolio-label">05 · Social and content</p>
					<h2 id="social-title" class="portfolio-heading">Painting in public.</h2>
				</div>
				<p>I plan, shoot, edit and post my own content. It is the same work I do for brands, with my own paintings as the product.</p>
			</header>
			<div class="play-social">
				{socialChannels.map((channel) => (
					<a class="play-social-card" href={channel.url} target="_blank" rel="me noopener">
						<img
							src={channel.image}
							alt={channel.alt}
							width={channel.width}
							height={channel.height}
							loading="lazy"
							decoding="async"
						/>
						<p class="portfolio-label">{channel.platform} · {channel.handle}</p>
						<h3>{channel.title}</h3>
						<p>{channel.body}</p>
						<div class="portfolio-chips">{channel.tags.map((tag) => <span>{tag}</span>)}</div>
					</a>
				))}
			</div>
		</section>

		<ClosingBand
			title="Take one home."
			description="Cards, downloads and original watercolours. Most of what you just scrolled through lives in my shop (in Spanish)."
			primaryLabel="Visit the shop ↗"
			primaryHref={shop}
			secondaryLabel="See conversion work →"
			secondaryHref="/work/"
		/>

		<dialog class="play-viewer" aria-label="Artwork viewer">
			<button class="viewer-close" type="button" aria-label="Close" autofocus>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
			<button class="viewer-previous" type="button" aria-label="Previous artwork">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
			</button>
			<figure></figure>
			<button class="viewer-next" type="button" aria-label="Next artwork">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
			</button>
		</dialog>
	</main>
</Layout>

<script>
	const viewer = document.querySelector<HTMLDialogElement>(".play-viewer");
	const stage = viewer?.querySelector("figure");
	const image = new Image();
	const artworkLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-gallery-image]")];
	let openLinks: HTMLAnchorElement[] = [];
	let selected = 0;

	// The viewer pages through the section the clicked piece belongs to.
	function show(index: number) {
		if (!openLinks.length) return;

		selected = (index + openLinks.length) % openLinks.length;
		const link = openLinks[selected];
		image.src = link.href;
		image.alt = link.querySelector("img")?.alt ?? "";
		if (!image.isConnected) stage?.append(image);
	}

	for (const link of artworkLinks) {
		link.addEventListener("click", (event) => {
			if (!viewer || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			event.preventDefault();
			const section = link.closest("section");
			openLinks = artworkLinks.filter((item) => item.closest("section") === section);
			show(openLinks.indexOf(link));
			viewer.showModal();
		});
	}

	viewer?.querySelector(".viewer-close")?.addEventListener("click", () => viewer.close());
	viewer?.querySelector(".viewer-previous")?.addEventListener("click", () => show(selected - 1));
	viewer?.querySelector(".viewer-next")?.addEventListener("click", () => show(selected + 1));
	viewer?.addEventListener("click", (event) => {
		if (event.target === viewer || event.target === stage) viewer.close();
	});
	viewer?.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") show(selected - 1);
		if (event.key === "ArrowRight") show(selected + 1);
	});
</script>

<style>
	/* Compact top of page so the first gallery shows straight away. */
	.play-page {
		--section-gap: clamp(48px, 6vw, 80px);
	}

	.vd-intro {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 8px 32px;
		padding-block: clamp(16px, 2.5vw, 32px) clamp(20px, 2.5vw, 32px);
	}

	.vd-intro h1 {
		margin: 0;
		color: var(--pink);
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.vd-intro p {
		max-width: 520px;
		margin: 0;
		color: var(--secondary);
	}

	.vd-intro + .portfolio-section {
		padding-top: 0;
	}

	.play-page :global(.closing-copy h2) {
		font-size: clamp(2.65rem, 7.5vw, 6rem);
	}

	.watercolour-band {
		background: #fff;
		color: var(--deep);
		padding-block: clamp(48px, 7vw, 88px);
	}

	.play-split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 48px;
		align-items: end;
		margin-bottom: clamp(16px, 2vw, 24px);
	}

	.play-page h2 {
		margin: 0;
		font-size: clamp(28px, 3.2vw, 44px);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.play-page .portfolio-label {
		margin: 0 0 12px;
	}

	.play-split > p {
		margin: 0;
		color: var(--secondary);
		font-size: 18px;
		line-height: 1.5;
	}

	.watercolour-band .portfolio-label {
		color: var(--brand-wine);
	}

	.watercolour-band .play-split > p {
		color: #5d4f53;
	}

	.watercolour-grid,
	.play-social {
		display: grid;
		gap: 20px;
	}

	.watercolour-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.gallery-item {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.gallery-item[hidden] {
		display: none;
	}

	.gallery-item img {
		display: block;
		width: 100%;
		border-radius: 16px;
		height: auto;
	}

	.gallery-item:hover img {
		filter: brightness(0.93);
	}

	.watercolour-grid .gallery-item img {
		border-radius: 20px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: #f4f2f3;
	}

	.watercolour-caption {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
		margin-top: 12px;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.watercolour-caption > span {
		color: var(--pink);
		font: 12px ui-monospace, Menlo, monospace;
		letter-spacing: normal;
	}






	.digital-wall {
		columns: 4;
		column-gap: 16px;
	}

	.digital-wall.wall-3 {
		columns: 3;
	}

	.digital-wall .gallery-item {
		break-inside: avoid;
		margin-bottom: 16px;
	}

	.digital-wall img {
		background: var(--raised);
	}




	.play-social {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.play-social-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: clamp(20px, 3vw, 32px);
		border-radius: 28px;
		background: var(--raised);
		color: var(--ink);
		text-decoration: none;
	}

	.play-social-card:first-child {
		background: var(--brand-wine);
		--secondary: var(--on-wine);
		--hairline: var(--on-wine);
	}

	.play-social-card:hover h3 {
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.play-social-card img {
		width: 100%;
		height: clamp(132px, 20.32vw, 260px);
		border-radius: 16px;
		object-fit: contain;
		background: var(--ground);
	}

	.play-social-card h3 {
		margin: 0;
		font-size: clamp(30px, 3.125vw, 40px);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.play-social-card p,
	.play-social-card .portfolio-label {
		color: var(--secondary);
		margin: 0;
	}

	.play-social-card .portfolio-label {
		overflow-wrap: anywhere;
	}

	.play-social-card .portfolio-chips {
		margin-top: auto;
	}

	.play-viewer {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		border: 0;
		padding: 56px 24px;
		background: transparent;
		color: #fff;
	}

	.play-viewer[open] {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 12px;
		align-items: center;
	}

	.play-viewer::backdrop {
		background: rgb(23 15 18 / 96%);
	}

	:global(html:has(.play-viewer[open])) {
		overflow: hidden;
	}

	.play-viewer figure {
		display: grid;
		place-items: center;
		margin: 0;
		height: 100%;
		min-height: 0;
	}

	.play-viewer :global(img) {
		display: block;
		max-width: 100%;
		max-height: calc(100dvh - 112px);
		border-radius: 12px;
		object-fit: contain;
	}

	.play-viewer button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--hairline);
		border-radius: 50%;
		background: var(--deep-raised);
		color: #fff;
		cursor: pointer;
	}

	.play-viewer button:hover {
		background: var(--brand-wine);
	}

	.viewer-close {
		position: absolute;
		top: 12px;
		right: 16px;
	}

	@media (max-width: 900px) {
		.digital-wall { columns: 3; }
		.play-split { gap: 24px; }
	}

	@media (max-width: 650px) {
		.play-split,
		.play-social {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.watercolour-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.watercolour-caption { font-size: 16px; }
		.digital-wall,
		.digital-wall.wall-3 { columns: 2; }

		.play-viewer[open] {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: minmax(0, 1fr) auto;
		}

		.play-viewer figure {
			grid-row: 1;
			grid-column: 1 / -1;
		}

		.play-viewer :global(img) { max-height: calc(100dvh - 170px); }
		.viewer-previous { justify-self: end; }
	}
</style>
