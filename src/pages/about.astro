---
import resume from "../../public/resume.json";
import ClosingBand from "../components/ClosingBand.astro";
import PageIntro from "../components/PageIntro.astro";
import { beyondUx, breadcrumbSchema, capabilities, personId, site } from "../data/site";
import Layout from "../layouts/Layout.astro";

// The full Person node lives in Layout.astro; reference it rather than a second, thinner copy.
const profileSchema = {
	"@type": "ProfilePage",
	url: `${site.url}/about/`,
	mainEntity: { "@id": personId },
};

const facts = [
	["Timezone", "UTC−5"],
	["Remote experience", "Since 2018"],
	["Languages", "English / Spanish"],
	["Availability", "US business hours"],
];
const skills = [
	{ ...capabilities[0], title: "Ecommerce and marketplace creative" },
	{ ...capabilities[1], title: "Shopify and CRO" },
	{ ...capabilities[2], title: "Product, brand and design systems" },
];
const aiTools = ["Claude Code", "Figma", "AI-assisted prototyping", "Asset variants"];
const featuredRoles = ["Mariana Ordoñez", "eStoreLabs", "trades.org", "Casabianca Cycling Apparel"];
const career = resume.work.filter((role) => featuredRoles.includes(role.name));
const certificate = resume.certificates.find(({ issuer }) => issuer === "IBM");
const featuredArt = [
	"creyente-brand", "creyente-quimeras", "cecilia-burger", "cecilia-chefs",
	"creyente-ritual", "perfecto-exfoliantes", "cecilia-email", "marrana-eats",
];
const gallery = featuredArt.flatMap((slug) => beyondUx.filter((item) => item.slug === slug));
const galleryItems = [...gallery, ...beyondUx.filter(({ slug }) => !featuredArt.includes(slug))];
---

<Layout
	title="About - Remote Ecommerce Graphic Designer, US Hours, Colombia"
	description="Remote Ecommerce Graphic Designer in Bogotá. Shopify, Amazon A+, paid-social creative and AI-assisted design for ecommerce and product."
	path="/about/"
	type="profile"
	schema={[profileSchema, breadcrumbSchema([["About", "/about/"]])]}
>
	<main class="about">
		<PageIntro
			word="About"
			label="Remote nearshore designer · Bogotá"
			title="I design things that have to perform."
			description="Eight years designing Shopify stores, Amazon A+ content, emails and paid social for ecommerce. Since 2026, I’ve also designed, coded and run my own Shopify store. AI helps me work faster, from prototype to production."
			portrait="/brand/mariana-portrait.webp"
		>
			<div class="intro-actions">
				<a class="portfolio-button" href="/contact/">Book a call <span aria-hidden="true">→</span></a>
				<a class="portfolio-button about-outline" href={site.resumeUrl}>Download CV <span aria-hidden="true">↓</span></a>
			</div>
		</PageIntro>

		<section class="container" aria-labelledby="collaboration-heading">
			<header class="about-heading">
				<h2 class="portfolio-title" id="collaboration-heading"><span class="portfolio-label">How I work</span>Senior craft, inside your workday.</h2>
				<p>Based in Colombia, bilingual, and working with remote US teams since 2018. My workday overlaps with yours, so we can make decisions together.</p>
			</header>
			<dl class="about-facts">
				{facts.map(([label, value]) => (
					<div>
						<dt class="portfolio-label">{label}</dt>
						<dd>{value}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="container portfolio-section" aria-labelledby="skills-heading">
			<h2 class="portfolio-title" id="skills-heading"><span class="portfolio-label">Skills and tools</span>What I bring to a team.</h2>
			<article class="about-feature portfolio-card">
				<span class="skill-number" aria-hidden="true">01</span>
				<div>
					<h3>AI-accelerated workflow</h3>
					<p>I use tools like Claude Code to explore variants, build prototypes and iterate faster. I make the final design and conversion decisions.</p>
					<div class="portfolio-chips">{aiTools.map((tool) => <span>{tool}</span>)}</div>
				</div>
			</article>
			<div class="about-skills">
				{skills.map((skill, index) => (
					<article class="portfolio-card">
						<span class="skill-number" aria-hidden="true">0{index + 2}</span>
						<h3>{skill.title}</h3>
						<p>{skill.description}</p>
						<div class="portfolio-chips">{skill.tags.map((tag) => <span>{tag}</span>)}</div>
					</article>
				))}
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="career-heading">
			<header class="about-heading career-heading">
				<h2 class="portfolio-title" id="career-heading">Career</h2>
				<a href={site.resumeUrl}>Download CV <span aria-hidden="true">↓</span></a>
			</header>
			<ol class="career-list">
				{career.map((role) => (
					<li>
						<span class="career-date">{role.startDate.slice(0, 4)} – {role.endDate ? role.endDate.slice(2, 4) : "now"}</span>
						<div>
							<h3>{role.position}</h3>
							<p>{role.name === "Mariana Ordoñez" ? "My own Shopify store" : role.name}</p>
						</div>
						<p>{role.summary}</p>
					</li>
				))}
			</ol>
		</section>

		{certificate && (
			<section class="portfolio-light certification" id="certification" aria-labelledby="certificate-heading">
				<div class="container certification-inner">
					<span aria-hidden="true">{certificate.issuer}</span>
					<div>
						<p class="portfolio-label">Certification</p>
						<h2 class="portfolio-title" id="certificate-heading">{certificate.name}</h2>
						<p>Issued by {certificate.issuer} in {certificate.date}.</p>
					</div>
				</div>
			</section>
		)}

		<section class="container portfolio-section" aria-labelledby="brand-heading">
			<header class="about-heading">
				<h2 class="portfolio-title" id="brand-heading"><span class="portfolio-label">Beyond commerce</span>Brand and visual design work.</h2>
				<p>From a mezcal identity to restaurant and lifestyle campaigns, I design how brands look and speak.</p>
			</header>
			<div class="bx-gallery">
				{gallery.map((item) => (
					<button class="bx-item" type="button" aria-label={`Open ${item.alt}`} aria-haspopup="dialog">
						<span class="bx-frame">
							<img src={`/images/marketing/other/thumbs/${item.slug}.webp`} alt="" loading="lazy" decoding="async" />
						</span>
						<span class="bx-cap">{item.brand}</span>
					</button>
				))}
			</div>
		</section>

		<ClosingBand
			title="Let's build something that performs."
			description="Open to remote ecommerce, product and marketing design roles."
			primaryLabel="Book a call →"
			primaryHref="/contact/"
			secondaryLabel="Download CV ↓"
			secondaryHref={site.resumeUrl}
		/>

		<dialog class="lightbox" id="lightbox" aria-label="Brand work gallery">
			<button class="lb-close" type="button" aria-label="Close" autofocus>&times;</button>
			<button class="lb-nav lb-prev" type="button" aria-label="Previous">&#8249;</button>
			<figure class="lb-stage">
				<img id="lb-img" src="/images/marketing/other/creyente-brand.webp" alt="" loading="lazy" />
			</figure>
			<button class="lb-nav lb-next" type="button" aria-label="Next">&#8250;</button>
		</dialog>
	</main>
</Layout>

<script define:vars={{ items: galleryItems }}>
	const lb = document.getElementById("lightbox");
	const img = document.getElementById("lb-img");
	const triggers = document.querySelectorAll(".bx-item");
	let index = 0;

	const show = (i) => {
		index = (i + items.length) % items.length;
		const item = items[index];
		img.classList.remove("is-tall");
		img.onload = () => {
			if (img.naturalHeight / img.naturalWidth > 1.8) img.classList.add("is-tall");
		};
		img.alt = item.alt;
		img.src = `/images/marketing/other/${item.slug}.webp`;
	};
	triggers.forEach((el, i) => el.addEventListener("click", () => {
		show(i);
		lb.showModal();
	}));
	lb.querySelector(".lb-close").addEventListener("click", () => lb.close());
	lb.querySelector(".lb-prev").addEventListener("click", () => show(index - 1));
	lb.querySelector(".lb-next").addEventListener("click", () => show(index + 1));
	lb.addEventListener("click", (event) => {
		if (event.target === lb || event.target.classList.contains("lb-stage")) lb.close();
	});
	lb.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") show(index - 1);
		if (event.key === "ArrowRight") show(index + 1);
	});
</script>

<style>
	.about p, .about h3 { margin: 0; }
	.intro-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.intro-actions > a { gap: 6px; }
	.about .about-outline {
		background: transparent;
		border: 1.5px solid currentColor;
		color: inherit;
	}
	.about .about-outline:hover { background: white; color: var(--deep); }
	.about-heading {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: end;
		gap: 24px 48px;
		margin-bottom: 32px;
	}
	.about-heading > p {
		font-size: 18px;
		color: var(--secondary);
	}
	.about .portfolio-title > .portfolio-label {
		display: block;
		margin-bottom: 12px;
		letter-spacing: 0;
	}
	.about-facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5px;
		margin: 0;
		border: 1.5px solid var(--hairline);
		background: var(--hairline);
	}
	.about-facts > div { background: var(--ground); padding: 24px; }
	.about-facts > div:last-child { background: var(--brand-wine); }
	.about-facts > div:last-child dt { color: var(--on-wine); }
	.about-facts dd {
		margin: 10px 0 0;
		font-size: clamp(22px, 2.35vw, 30px);
		line-height: 1.05;
		letter-spacing: -.03em;
		font-weight: 700;
	}
	.about-feature {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 40px;
		align-items: center;
		margin-top: 32px;
		padding: clamp(24px, 4vw, 40px);
		background: var(--brand-wine);
	}
	.about-feature > div {
		display: grid;
		gap: 14px;
	}
	.about-feature h3 { font-size: clamp(28px, 3.2vw, 40px); }
	.about-feature p {
		max-width: 640px;
		color: var(--on-wine);
		font-size: 17px;
	}
	.about-feature .portfolio-chips > span { border-color: var(--on-wine); }
	.skill-number {
		color: var(--pink);
		font-weight: 700;
		font-size: 56px;
		line-height: 1;
		letter-spacing: -.04em;
	}
	.about-feature .skill-number {
		font-size: clamp(64px, 13vw, 160px);
		line-height: .8;
		letter-spacing: -.06em;
	}
	.about-skills {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 20px;
	}
	.about-skills article {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: clamp(24px, 3vw, 32px);
	}
	.about-skills h3 { font-size: 26px; line-height: 1.1; }
	.about-skills p { color: var(--secondary); font-size: 15px; }
	.about-skills .portfolio-chips { margin-top: auto; }
	.career-heading {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
	}
	.career-heading a { color: var(--pink); font-weight: 700; }
	.career-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-bottom: 1.5px solid var(--hairline);
	}
	.career-list li {
		display: grid;
		grid-template-columns: minmax(155px, 240px) 1fr 1.2fr;
		gap: 12px 28px;
		align-items: baseline;
		padding: 28px 0;
		border-top: 1.5px solid var(--hairline);
	}
	.career-date {
		color: var(--pink);
		font-size: clamp(28px, 3.15vw, 40px);
		font-weight: 700;
		letter-spacing: -.04em;
		line-height: 1;
	}
	.career-list h3 { font-size: 24px; }
	.career-list h3 + p { margin-top: 4px; font-size: 15px; }
	.career-list p { color: var(--secondary); }
	.certification { margin-top: clamp(60px, 8vw, 96px); }
	.certification-inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: clamp(24px, 5vw, 56px);
		padding-block: clamp(44px, 6vw, 72px);
	}
	.certification-inner > span {
		color: var(--brand-wine);
		font-weight: 700;
		font-size: clamp(84px, 18vw, 220px);
		line-height: .8;
		letter-spacing: -.06em;
	}
	.certification .portfolio-label { color: var(--brand-wine); }
	.certification .portfolio-title {
		margin: 12px 0;
		font-size: clamp(32px, 4vw, 48px);
		color: var(--deep);
	}
	.certification p:last-child { color: #5d4f53; font-size: 18px; }
	.about .bx-gallery {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px 16px;
	}
	.about .bx-frame {
		aspect-ratio: 1;
		border-radius: 16px;
		box-shadow: none;
	}
	.about .bx-cap { font-size: 15px; color: inherit; padding-inline: 0; }
	.about .bx-item { color: inherit; }
	.about .bx-item:focus-visible { outline-color: var(--pink); }
	.about .lightbox {
		margin: 0;
		border: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
	}
	.about .lightbox:not([open]) { display: none; }
	:global(html:has(.about .lightbox[open])) { overflow: hidden; }
	@media (max-width: 850px) {
		.about-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.about-skills { grid-template-columns: 1fr; }
		.about .bx-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.career-list li { grid-template-columns: minmax(120px, .4fr) 1fr; }
		.career-list li > p { grid-column: 2; }
	}
	@media (max-width: 560px) {
		.about-heading, .about-feature, .career-list li, .certification-inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.about-feature { gap: 22px; }
		.career-list li > p { grid-column: auto; }
	}
</style>
