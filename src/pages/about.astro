---
import Layout from "../layouts/Layout.astro";
import { beyondUx, capabilities, site, socialLinks, contactHref } from "../data/site";

const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	mainEntity: {
		"@type": "Person",
		name: site.name,
		jobTitle: site.role,
		url: site.url,
		email: site.email,
	},
};
---

<Layout
	title="About - Remote Product Designer, US Hours, Colombia"
	description="Remote Agentic Product & AI UX Designer in Colombia, working US hours. AI-native workflow in Figma and Claude Code, end-to-end product and design systems, with 6+ years of conversion-driven commerce."
	path="/about/"
	type="profile"
>
	<script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>Remote nearshore product designer</p>
			<h1 class="page-title">I design things that have to perform.</h1>
			<p class="page-lede">
				I am an Agentic Product & AI UX Designer with 6+ years designing end-to-end product and
				conversion-focused commerce experiences. AI-native tooling like Claude Code is how I work fast. Craft is how the work stays
				worth shipping.
			</p>
			<div class="actions">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href={site.resumeUrl}>Download resume</a>
			</div>
		</section>

		<section class="container section tight feature-split">
			<div>
				<p class="kicker">How I work</p>
				<h2 class="section-title">Senior US-quality craft, inside your workday.</h2>
				<p class="section-copy">
					I am based in Colombia, UTC-5, bilingual and experienced with fully remote EST teams
					since 2018. That means real-time collaboration with US teams, not overnight handoff.
				</p>
			</div>
			<div class="demo-panel">
				<div class="demo-screen">
					<div class="demo-row"><strong>Timezone</strong><span>UTC-5</span></div>
					<div class="demo-row"><strong>Remote experience</strong><span>Since 2018</span></div>
					<div class="demo-row"><strong>Focus</strong><span>Agentic, product, CRO</span></div>
					<div class="demo-row"><strong>Availability</strong><span>US business hours</span></div>
				</div>
			</div>
		</section>

		<section class="container section tight">
			<div class="section-head">
				<div>
					<p class="kicker">Skills and tools</p>
					<h2 class="section-title">What I bring to a team.</h2>
				</div>
			</div>
			<div class="grid-3">
				{
					capabilities.map((capability) => (
						<article class="card">
							<h3>{capability.title}</h3>
							<p>{capability.description}</p>
							<div class="tags">
								{capability.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="container section tight">
			<div class="grid-2">
				<article class="card">
					<p class="kicker">Certification</p>
					<h2>IBM Generative AI for UX Design.</h2>
					<p>
						A credibility marker for AI-native, agentic product-design workflows.
					</p>
				</article>
				<article class="card">
					<p class="kicker">Profiles</p>
					<h2>One clear identity across platforms.</h2>
					<p>
						Agentic Product & AI UX Designer stays consistent across LinkedIn, Behance, email
						and resume touchpoints.
					</p>
					<div class="tags">
						{socialLinks.map((link) => <span class="tag">{link.label}</span>)}
					</div>
				</article>
			</div>
		</section>

		<section class="container section tight">
			<div class="section-head">
				<div>
					<p class="kicker">Beyond UX</p>
					<h2 class="section-title">Brand and visual design work.</h2>
					<p class="section-copy">
						Alongside product and commerce, I design brand and marketing work for other clients -
						from a mezcal identity to restaurant and lifestyle campaigns. The same craft, applied to
						how a brand looks and speaks.
					</p>
				</div>
			</div>
			<div class="bx-gallery">
				{
					beyondUx.map((item) => (
						<button class="bx-item" type="button" aria-label={`Open ${item.alt}`}>
							<span class="bx-frame">
								<img
									src={`/images/marketing/other/thumbs/${item.slug}.webp`}
									alt={item.alt}
									loading="lazy"
									decoding="async"
								/>
							</span>
							<span class="bx-cap">{item.brand}</span>
						</button>
					))
				}
			</div>
		</section>

		<section class="container cta-band">
			<h2>Let's build something that performs.</h2>
			<p>I am open to remote product, UX and eCommerce design roles.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href={contactHref}>Email Mariana <span aria-hidden="true">-></span></a>
				<a class="text-link" href={site.resumeUrl}>Download resume</a>
			</div>
		</section>

		<div class="lightbox" id="lightbox" hidden>
			<button class="lb-close" type="button" aria-label="Close">&times;</button>
			<button class="lb-nav lb-prev" type="button" aria-label="Previous">&#8249;</button>
			<figure class="lb-stage">
				<img id="lb-img" src="" alt="" />
			</figure>
			<button class="lb-nav lb-next" type="button" aria-label="Next">&#8250;</button>
		</div>
	</main>
</Layout>

<script define:vars={{ items: beyondUx }}>
	const lb = document.getElementById("lightbox");
	const img = document.getElementById("lb-img");
	const triggers = [...document.querySelectorAll(".bx-item")];
	let index = 0;
	let lastFocused = null;

	const show = (i) => {
		index = (i + items.length) % items.length;
		const item = items[index];
		img.classList.remove("is-tall");
		img.onload = () => {
			if (img.naturalHeight / img.naturalWidth > 1.8) img.classList.add("is-tall");
		};
		img.src = `/images/marketing/other/${item.slug}.webp`;
		img.alt = item.alt;
	};
	const open = (i) => {
		lastFocused = document.activeElement;
		show(i);
		lb.hidden = false;
		document.body.style.overflow = "hidden";
		lb.querySelector(".lb-close").focus();
	};
	const close = () => {
		lb.hidden = true;
		img.src = "";
		document.body.style.overflow = "";
		lastFocused?.focus();
	};
	triggers.forEach((el, i) => el.addEventListener("click", () => open(i)));
	lb.querySelector(".lb-close").addEventListener("click", close);
	lb.querySelector(".lb-prev").addEventListener("click", () => show(index - 1));
	lb.querySelector(".lb-next").addEventListener("click", () => show(index + 1));
	lb.addEventListener("click", (event) => {
		if (event.target === lb || event.target.classList.contains("lb-stage")) close();
	});
	document.addEventListener("keydown", (event) => {
		if (lb.hidden) return;
		if (event.key === "Escape") close();
		if (event.key === "ArrowLeft") show(index - 1);
		if (event.key === "ArrowRight") show(index + 1);
	});
</script>
