	Lovable: `<svg viewBox="0 0 30 30" width="30" height="30" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="loveG" x1="7" y1="6" x2="23" y2="23" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#ff7a9c"/><stop offset="1" stop-color="#f5385b"/></linearGradient></defs><rect width="30" height="30" rx="7" fill="#fff"/><path fill="url(#loveG)" d="M15 23.5s-8.4-5.2-8.4-10.6a4.9 4.9 0 0 1 9-2.7l.4.6.4-.6a4.9 4.9 0 0 1 9 2.7c0 5.4-8.4 10.6-8.4 10.6z"/></svg>`,
	Asana: `<svg viewBox="0 0 30 30" width="30" height="30" xmlns="http://www.w3.org/2000/svg"><rect width="30" height="30" rx="7" fill="#fff"/><g fill="#f06a6a"><circle cx="15" cy="10" r="3.9"/><circle cx="9.5" cy="19.6" r="3.9"/><circle cx="20.5" cy="19.6" r="3.9"/></g></svg>`,
	Photoshop: badge("#001e36", "#31a8ff", "Ps"),
	Illustrator: badge("#330000", "#ff9a00", "Ai"),
	"After Effects": badge("#00005b", "#9999ff", "Ae"),
	Procreate: badge("#a6774b", "#fff", "Pc"),
	"Shopify-aware UX": badge("#7ab55c", "#fff", "S", 14),
	Klaviyo: badge("#1a1a1a", "#fff", "K", 14),
	Notion: `<svg viewBox="0 0 30 30" width="30" height="30" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="29" height="29" rx="6.5" fill="#fff" stroke="rgba(0,0,0,0.14)"/><text x="15" y="15" dy="0.35em" font-family="Georgia, 'Times New Roman', serif" font-weight="700" font-size="15" fill="#111" text-anchor="middle">N</text></svg>`,
};
---

<Layout
	title="Tools - My Design Stack + Free Resources"
	description="Mariana Ordonez's design tool stack and free resources for eCommerce CRO, digital-shelf and PDP design, Figma systems and AI-assisted workflows."
	path="/tools/"
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>Designer tool stack and resources</p>
			<h1 class="page-title">My design stack, plus free resources.</h1>
			<p class="page-lede">
				A modern, conversion-focused workflow for eCommerce and graphic design, brand systems and
				remote handoff - AI-assisted where it helps.
			</p>
		</section>

		<section class="container section tight">
			<div class="section-head">
				<div>
					<p class="kicker">My stack</p>
					<h2 class="section-title">Tools, grouped by what they help ship.</h2>
				</div>
			</div>
			<div class="grid-2">
				{
					toolStack.map((group) => (
						<article class="card">
							<p class="kicker">{group.items.join(" / ")}</p>
							<h2>{group.category}</h2>
							<p>{group.description}</p>
							{group.items.some((item) => toolLogos[item]) && (
								<div class="tool-logos">
									{group.items
										.filter((item) => toolLogos[item])
										.map((item) => (
											<span class="tool-logo" title={item} set:html={toolLogos[item]} />
										))}
								</div>
							)}
							<div class="tags">
								{group.items.map((item) => (
									<span class="tag">{item}</span>
								))}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="container section">
			<div class="section-head">
				<div>
					<p class="kicker">Free resources</p>
					<h2 class="section-title">Things I made that you can take.</h2>
					<p class="section-copy">
						These lead magnets map to the Journal topics and can later be gated through
						Neon-backed leads and resources tables.
					</p>
				</div>
			</div>
			<div class="grid-2">
				{
					resources.map((resource) => {
						const r = resource as { file?: string; kind?: string; cta?: string };
						return r.file ? (
							<a class="card" href={r.file} target="_blank" rel="noopener">
								<p class="kicker">Resource · {r.kind ?? "Free"}</p>
								<h2>{resource.title}</h2>
								<p>{resource.description}</p>
								<p class="metric">{r.cta ?? "Open the resource"} -></p>
							</a>
						) : (
							<a class="card" href={`mailto:${site.email}?subject=${encodeURIComponent(resource.title)}`}>
								<p class="kicker">Resource</p>
								<h2>{resource.title}</h2>
								<p>{resource.description}</p>
								<p class="metric">Request the file -></p>
							</a>
						);
					})
				}
			</div>
		</section>

		<section class="container cta-band">
			<h2>Want a designer who already knows this stack?</h2>
			<p>I can plug into product, design, eCommerce and remote teams without a long ramp.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href="/work/">See the work</a>
			</div>
		</section>
	</main>
</Layout>
