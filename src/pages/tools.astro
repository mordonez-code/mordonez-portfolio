---
import ClosingBand from "../components/ClosingBand.astro";
import PageIntro from "../components/PageIntro.astro";
import { resources, toolStack } from "../data/site";
import Layout from "../layouts/Layout.astro";

const [design, ai, visual, ecommerce, process] = toolStack;
const groups = [design, visual, ecommerce, process];
const [featured, ...downloads] = resources;
const toolBadges = ["CC", "GPT", "Ge", "NB", "Pa", "Lo"];
const resourceMarks = ["{ }", ">_", "@"];
const totals = [
	{ value: toolStack.length, label: "categories, grouped by what they help ship" },
	{ value: toolStack.reduce((sum, group) => sum + group.items.length, 0), label: "tools and practices" },
	{ value: resources.length, label: "free resources" },
];
const checklistPreview = [
	"Above the fold & first impression",
	"Value proposition & offer clarity",
	"Imagery, media & gallery",
	"Social proof & trust",
];
---

<Layout
	title="Tools · My Design Stack + Free Resources"
	description="Mariana Ordoñez’s design tool stack and free resources for ecommerce, Figma systems and AI-assisted workflows."
	path="/tools/"
>
	<main class="tools-page">
		<PageIntro
			word="Tools"
			label="Design stack + free resources"
			title="My design stack, plus things you can take."
			description="A conversion-focused workflow for ecommerce and graphic design, brand systems and remote handoff, AI-assisted where it helps."
		/>

		<div class="container">
			<ul class="tools-totals" aria-label="Tools and resources at a glance">
				{totals.map(({ value, label }) => (
					<li>
						<strong>{value}</strong>
						<span>{label}</span>
					</li>
				))}
			</ul>
		</div>

		<section class="container portfolio-section tools-stack" aria-label="Design tool stack">
			<div class="ai-stack">
				<header>
					<div>
						<p class="portfolio-label">01 / 05 · The speed layer</p>
						<h2 class="portfolio-heading">{ai.category}</h2>
					</div>
					<p>{ai.description}</p>
				</header>
				<ul class="tool-tiles">
					{ai.items.slice(0, toolBadges.length).map((item, index) => (
						<li>
							<span class="tool-badge" aria-hidden="true">{toolBadges[index]}</span>
							<span>{item}</span>
						</li>
					))}
				</ul>
				<ul class="portfolio-chips ai-practices">
					{ai.items.slice(toolBadges.length).map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<ol class="stack-rows" start="2">
				{groups.map((group, index) => (
					<li class="stack-row">
						<span class="stack-number" aria-hidden="true">0{index + 2}</span>
						<div>
							<h2>{group.category}</h2>
							<p>{group.description}</p>
						</div>
						<ul class="portfolio-chips">{group.items.map((item) => <li>{item}</li>)}</ul>
					</li>
				))}
			</ol>
		</section>

		<section class="container portfolio-section" aria-labelledby="checklist-title">
			<div class="featured-checklist">
				<div class="checklist-copy">
					<p class="portfolio-label">Free resource · {featured.kind}</p>
					<h2 class="portfolio-heading" id="checklist-title">{featured.title}.</h2>
					<p>{featured.description}</p>
					<a class="portfolio-button" href={featured.file} target="_blank" rel="noopener">
						{featured.cta} <span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="checklist-frame" aria-hidden="true">
					<div class="checklist-preview">
						<p>Free resource · Conversion design</p>
						<strong>PDP &amp; Landing-Page CRO Checklist</strong>
						<ul>
							{checklistPreview.map((topic) => <li>{topic}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="download-title">
			<h2 class="portfolio-heading download-title" id="download-title">Things I made that you can take.</h2>
			<div class="resource-grid">
				{downloads.map((resource, index) => (
					<a class="tool-resource" href={resource.file} target="_blank" rel="noopener">
						<span class="resource-cover" aria-hidden="true">{resourceMarks[index]}</span>
						<span class="resource-copy">
							<span class="portfolio-label">{resource.kind}</span>
							<strong>{resource.title}</strong>
							<span class="resource-description">{resource.description}</span>
							<span class="resource-link">{resource.cta} <span aria-hidden="true">→</span></span>
						</span>
					</a>
				))}
			</div>
		</section>

		<section class="container tools-philosophy" aria-labelledby="philosophy-title">
			<p class="portfolio-label">Philosophy</p>
			<h2 id="philosophy-title">AI where it helps. <span>Human judgment</span> at the center.</h2>
		</section>

		<ClosingBand
			title="Want a designer who already knows this stack?"
			primaryLabel="Book a call →"
			primaryHref="/contact/"
			secondaryLabel="See the work →"
			secondaryHref="/work/"
		/>
	</main>
</Layout>

<style>
	.tools-page {
		--intro-bottom: 48px;
		--closing-top: 0px;
	}

	.tools-page :global(.portfolio-intro h1) {
		font-size: clamp(2.5rem, 4.375vw, 3.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.tools-totals,
	.tool-tiles,
	.stack-rows,
	.tools-page .portfolio-chips {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools-totals {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5px;
		border: 1.5px solid var(--hairline);
		background: var(--hairline);
	}

	.tools-totals li {
		padding: clamp(16px, 2vw, 24px);
		background: var(--ground);
		color: var(--secondary);
		font-size: 14px;
	}

	.tools-totals li:last-child {
		background: var(--brand-wine);
		color: var(--on-wine);
	}

	.tools-totals strong {
		display: block;
		margin-bottom: 6px;
		color: var(--pink);
		font-size: clamp(40px, 5vw, 64px);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.tools-totals li:last-child strong {
		color: var(--ink);
	}

	.ai-stack,
	.featured-checklist {
		padding: clamp(22px, 4vw, 44px);
		border-radius: 28px;
	}

	.ai-stack {
		background: var(--brand-wine);
	}

	.ai-stack header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		align-items: end;
		gap: 48px;
		margin-bottom: 32px;
	}

	.tools-page .portfolio-label {
		margin: 0 0 12px;
	}

	.ai-stack .portfolio-label,
	.ai-stack header > p {
		color: var(--on-wine);
	}

	.ai-stack h2,
	.featured-checklist h2,
	.download-title {
		margin: 0;
		font-size: clamp(38px, 4.375vw, 56px);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.ai-stack h2 {
		font-size: clamp(42px, 5.625vw, 72px);
	}

	.ai-stack header > p,
	.checklist-copy > p:not(.portfolio-label) {
		margin: 0;
		font-size: 18px;
		line-height: 1.5;
	}

	.tool-tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.tool-tiles li {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: clamp(12px, 2vw, 20px);
		border-radius: 20px;
		background: var(--ground);
		font-size: clamp(16px, 2vw, 21px);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.tool-badge {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		flex: none;
		border-radius: 12px;
		background: var(--pink);
		color: var(--ground);
		font-size: 15px;
		letter-spacing: 0;
	}

	.tools-page .portfolio-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tools-page .portfolio-chips > li {
		padding: 7px 14px;
		border: 1.5px solid var(--hairline);
		border-radius: 99px;
		font-size: 14px;
		font-weight: 600;
	}

	.tools-page .ai-practices {
		margin-top: 20px;
		--hairline: var(--on-wine);
	}

	.tools-page .stack-rows {
		margin-top: 40px;
		border-bottom: 1.5px solid var(--hairline);
	}

	.stack-row {
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.3fr);
		align-items: start;
		gap: 28px;
		padding: 32px 0;
		border-top: 1.5px solid var(--hairline);
	}

	.stack-number {
		color: var(--pink);
		font-size: 44px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.stack-row h2 {
		margin: 0;
		font-size: 30px;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.stack-row p {
		margin: 8px 0 0;
		color: var(--secondary);
		font-size: 15px;
		line-height: 1.5;
	}

	.featured-checklist {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 44px;
		align-items: center;
		background: var(--pink);
		color: var(--ground);
	}

	.checklist-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		align-items: start;
	}

	.checklist-copy .portfolio-label,
	.featured-checklist h2 {
		color: inherit;
		margin-bottom: 0;
	}

	.checklist-copy .portfolio-button {
		background: var(--ground);
		color: var(--ink);
	}

	.checklist-copy .portfolio-button:hover {
		background: var(--brand-wine);
		color: #fff;
	}

	.checklist-frame {
		display: grid;
		place-items: center;
		height: 300px;
		overflow: hidden;
		padding: 32px;
		border-radius: 18px;
		background: #e7a4b4;
	}

	.checklist-preview {
		width: min(100%, 304px);
		padding: 22px;
		background: #fff;
		border-radius: 6px;
		color: var(--deep);
	}

	.checklist-preview p {
		margin: 0 0 8px;
		color: var(--brand-wine);
		font: 9px ui-monospace, Menlo, monospace;
		text-transform: uppercase;
	}

	.checklist-preview strong {
		display: block;
		margin-bottom: 12px;
		font-size: 19px;
		line-height: 1.05;
	}

	.checklist-preview ul {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--brand-wine);
		list-style: none;
	}

	.checklist-preview li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 0;
		border-bottom: 1px solid #eadce0;
		font-size: 11px;
	}

	.checklist-preview li::before {
		width: 9px;
		height: 9px;
		flex: none;
		border: 1px solid var(--brand-wine);
		content: "";
	}

	.download-title {
		margin-bottom: 28px;
	}

	.resource-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.tool-resource {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 24px;
		background: var(--raised);
		color: var(--ink);
		text-decoration: none;
	}

	.tool-resource:hover {
		background: var(--hover);
	}

	.resource-cover {
		display: flex;
		align-items: end;
		padding: 20px;
		height: 180px;
		background: var(--brand-wine);
		font-size: 72px;
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.04em;
	}

	.tool-resource:nth-child(2) .resource-cover {
		background: var(--hover);
		color: var(--pink);
	}

	.tool-resource:nth-child(3) .resource-cover {
		background: #fff;
		color: var(--brand-wine);
	}

	.resource-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 8px;
		padding: 24px;
	}

	.resource-copy .portfolio-label {
		margin: 0;
	}

	.resource-copy strong {
		font-size: 22px;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.resource-description {
		color: var(--secondary);
		font-size: 14px;
		line-height: 1.45;
	}

	.resource-link {
		margin-top: auto;
		padding-top: 8px;
		color: var(--pink);
		font-size: 15px;
		font-weight: 700;
	}

	.tool-resource:hover .resource-link {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.tools-philosophy {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 48px;
		align-items: center;
		padding-block: clamp(56px, 9.375vw, 120px);
	}

	.tools-philosophy .portfolio-label {
		margin: 0;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}

	.tools-philosophy h2 {
		margin: 0;
		font-size: clamp(42px, 7.5vw, 96px);
		line-height: 0.95;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.tools-philosophy h2 span {
		color: var(--pink);
	}

	@media (max-width: 860px) {
		.ai-stack header,
		.featured-checklist {
			gap: 24px;
		}

		.stack-row {
			grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.1fr);
			gap: 16px;
		}

		.tool-tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 650px) {
		.ai-stack header,
		.featured-checklist,
		.resource-grid,
		.tools-philosophy {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.stack-row {
			grid-template-columns: 42px minmax(0, 1fr);
		}

		.stack-number {
			font-size: 32px;
		}

		.stack-row .portfolio-chips {
			grid-column: 2;
		}

		.checklist-frame {
			height: auto;
			padding: 18px;
		}

		.resource-cover {
			height: 128px;
		}

		.tools-philosophy .portfolio-label {
			writing-mode: horizontal-tb;
			transform: none;
		}
	}

	@media (max-width: 400px) {
		.tool-tiles {
			grid-template-columns: 1fr;
		}

		.tools-totals li {
			padding: 10px;
			font-size: 12px;
		}
	}
</style>
