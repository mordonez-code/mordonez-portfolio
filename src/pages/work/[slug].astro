---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, caseStudies, personId, site } from "../../data/site";

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
const isFerrero = study.slug === "estore-labs-marketplace-cro";
const orderedStudies = [
	...caseStudies.filter(({ featured }) => featured),
	...caseStudies.filter(({ featured }) => !featured),
];
const nextStudy = orderedStudies[(orderedStudies.findIndex((item) => item.slug === study.slug) + 1) % orderedStudies.length];

const media = study as {
	cover?: string;
	coverPosition?: string;
	// Optional wide banner shown at the top of the case study; cards keep `cover`.
	banner?: string;
	gallery?: { src: string; title?: string; caption: string; maxWidth?: number }[];
	liveUrl?: string;
	liveLinks?: { title: string; body: string; linkLabel?: string; url?: string }[];
	marketing?: {
		dir: string;
		intro: string;
		images: { slug: string; alt: string; w: number; h: number }[];
		callouts?: { title: string; body: string }[];
	};
	showcase?: {
		dir: string;
		sections: {
			heading: string;
			note?: string;
			layout: "rail" | "stack" | "grid";
			items: { slug: string; title?: string; caption?: string }[];
		}[];
		callouts?: { title: string; body: string }[];
	};
};
const cover = media.cover;
const heroImage = media.banner ?? cover;
const coverPos = media.coverPosition ?? "center top";
const gallery = media.gallery;
const liveUrl = media.liveUrl;
const liveLinks = media.liveLinks;
const marketing = media.marketing;
const showcase = media.showcase;
const lightboxPreview = showcase
	? `/case-studies/${showcase.dir}/thumbs/${showcase.sections[0].items[0].slug}.webp`
	: marketing && `/images/marketing/${marketing.dir}/thumbs/${marketing.images[0].slug}.webp`;
const ferreroBrands = ["Ferrero Rocher", "Nutella", "Kinder", "Tic Tac", "Butterfinger", "Mother’s"];
const ferreroChannels = ["Amazon", "Walmart", "Instacart"];
const ferreroProcess = ["Sequence the listing", "Build reusable A+ modules", "Design for each retailer", "Ship seasonal campaigns"];
const ferreroHero = [
	{ slug: "fr-ec2", alt: "Ferrero Rocher Amazon A+ illustration with chocolate, hazelnuts and gold wrapping", width: 1024, height: 1024 },
	{ slug: "fr-main", alt: "Product carousel graphic labeling chocolate, hazelnut, wafer and filling", width: 1400, height: 1400 },
	{ slug: "fr-aplus", alt: "Hands sharing a box of Ferrero Rocher chocolates around a table", width: 1024, height: 1024 },
];
const butterfingerVariants = [
	{ letter: "A", label: "Pack and count first", alt: "Butterfinger Unwrapped Minis package, with a small candy cross-section at the lower right" },
	{ letter: "B", label: "Texture in the foreground", alt: "Butterfinger Unwrapped Minis package, with two large candy cross-sections in front" },
];

const pageUrl = `${site.url}/work/${study.slug}/`;
const caseStudySchema = {
	"@type": "CreativeWork",
	"@id": `${pageUrl}#case-study`,
	name: study.title,
	headline: study.outcome,
	description: study.summary,
	abstract: study.solution,
	url: pageUrl,
	genre: "Design case study",
	keywords: study.tags.join(", "),
	inLanguage: "en",
	...(cover ? { image: new URL(cover, site.url).toString() } : {}),
	creator: { "@id": personId },
	author: { "@id": personId },
	sourceOrganization: { "@type": "Organization", name: study.client },
};
---

<Layout
	title={`${study.title} - UX / CRO Case Study`}
	description={`${study.outcome} ${study.summary}`}
	path={`/work/${study.slug}/`}
	schema={[
		caseStudySchema,
		breadcrumbSchema([
			["Work", "/work/"],
			[study.title, `/work/${study.slug}/`],
		]),
	]}
>
	<main class="study-page">
		<header class="container study-intro">
			<div class="study-breadcrumb portfolio-label">
				<a href="/work/"><span aria-hidden="true">←</span> All work</a>
				<span aria-hidden="true">/</span>
				<span>{isFerrero ? "Ecommerce · AI" : study.client}</span>
			</div>
			<h1>{isFerrero ? "The Ferrero digital shelf: images that sell across US marketplaces." : study.outcome}</h1>
			{!isFerrero && <p class="study-lede">{study.summary}</p>}
			<dl class="study-details">
				<div><dt>Role</dt><dd>{study.role} · {study.client}</dd></div>
				<div><dt>When</dt><dd>{study.period}</dd></div>
				{isFerrero ? (
					<>
						<div><dt>Brands</dt><dd>{ferreroBrands.join(", ")}</dd></div>
						<div><dt>Channels</dt><dd>{ferreroChannels.join(", ")}</dd></div>
					</>
				) : (
					<>
						<div><dt>Timeline</dt><dd>{study.timeline}</dd></div>
						<div><dt>Tools</dt><dd>{study.tools}</dd></div>
					</>
				)}
			</dl>
			{liveUrl && <a class="study-live-link" href={liveUrl} target="_blank" rel="noopener">Visit {new URL(liveUrl).host} <span aria-hidden="true">↗</span></a>}
		</header>

		{isFerrero ? (
			<>
				<div class="study-wide study-mosaic" aria-label="Ferrero Rocher carousel and A+ content">
					{ferreroHero.map(({ slug, alt, width, height }) => (
						<img src={`/case-studies/estore-labs/shelf/${slug}.webp`} alt={alt} width={width} height={height} decoding="async" />
					))}
				</div>
				<dl class="study-wide study-metrics" aria-label="Project scope">
					<div><dt>Ferrero USA brands designed for</dt><dd>{ferreroBrands.length}</dd></div>
					<div><dt>US marketplaces</dt><dd>{ferreroChannels.length}</dd></div>
					<div><dt>Reusable digital-shelf system</dt><dd>1</dd></div>
				</dl>
			</>
		) : heroImage && (
			<figure class="study-wide study-cover">
				<img src={heroImage} alt={`${study.client} design case study`} style={{ objectPosition: coverPos }} />
			</figure>
		)}

		{isFerrero && (
			<>
				<section class="container study-brief" aria-labelledby="ferrero-brief">
					<h2 id="ferrero-brief">The brief</h2>
					<p>{study.problem}</p>
				</section>
				<section class="container study-workflow" aria-labelledby="ferrero-process">
					<h2 id="ferrero-process">How I work</h2>
					<ol>
						{study.process.map((step: string, index: number) => (
							<li>
								<span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
								<h3>{ferreroProcess[index]}</h3>
								<p>{step}</p>
							</li>
						))}
					</ol>
				</section>
				<section class="study-variants" aria-labelledby="ferrero-variants">
					<div class="container">
						<h2 id="ferrero-variants">Two ways to show the same product.</h2>
						<p>Butterfinger product-image concepts exploring pack legibility and the size of the candy cross-section.</p>
						<div class="study-variant-grid">
							{butterfingerVariants.map(({ letter, label, alt }) => (
									<figure>
										<img src={`/mockups/ecommerce-ab-${letter.toLowerCase()}.webp`} alt={alt} width="480" height="480" loading="lazy" decoding="async" />
										<figcaption><strong>Variant {letter}</strong><span>{label}</span></figcaption>
									</figure>
							))}
						</div>
					</div>
				</section>
			</>
		)}

		<section class="container section tight cs-body">
			<div class="prose">
				{!isFerrero && (
					<>
						<h2>The problem</h2>
						<p>{study.problem}</p>
						<h2>My process</h2>
						<ul>
							{study.process.map((step: string) => <li>{step}</li>)}
						</ul>
					</>
				)}
				<h2>The solution</h2>
				<p>{study.solution}</p>
				{isFerrero && <p>I also helped design an internal AI copilot that reviews marketplace imagery and prioritizes fixes before publication.</p>}
			</div>

			{
				showcase && (
					<div class="cs-showcase">
						{showcase.sections.map((section) => (
							<section class="shelf-section">
								<div class="shelf-head">
									<h2>{section.heading}</h2>
									{section.note && <p class="shelf-note">{section.note}</p>}
								</div>
								{section.layout !== "grid" ? (
									<div class={`cs-features${section.layout === "rail" ? " shelf-rail" : ""}`}>
										{section.items.map((item) => (
											<figure class="cs-feature">
												<figcaption>
													{item.title && <strong>{item.title}</strong>}
													{item.caption && <span>{item.caption}</span>}
												</figcaption>
												<button
													class="shelf-shot"
													type="button"
													data-lightbox
													data-full={`/case-studies/${showcase.dir}/${item.slug}.webp`}
													data-alt={item.title ?? item.caption ?? ""}
													aria-label={`Open ${item.title ?? item.caption ?? "image"}`}
												>
													<img src={`/case-studies/${showcase.dir}/thumbs/${item.slug}.webp`} alt={item.title ?? item.caption ?? ""} loading="lazy" decoding="async" />
												</button>
											</figure>
										))}
									</div>
								) : (
									<div class="shelf-grid">
										{section.items.map((item) => (
											<button
												class="shelf-tile"
												type="button"
												data-lightbox
												data-full={`/case-studies/${showcase.dir}/${item.slug}.webp`}
												data-alt={item.caption ?? ""}
												aria-label={`Open ${item.caption ?? "image"}`}
											>
												<span class="shelf-frame">
													<img src={`/case-studies/${showcase.dir}/thumbs/${item.slug}.webp`} alt={item.caption ?? ""} loading="lazy" decoding="async" />
												</span>
												{item.caption && <span class="shelf-cap">{item.caption}</span>}
											</button>
										))}
									</div>
								)}
							</section>
						))}
						{showcase.callouts && (
							<div class="mkt-callouts shelf-callouts">
								{showcase.callouts.map((c) => (
									<div class="mkt-callout">
										<strong>{c.title}</strong>
										<p>{c.body}</p>
									</div>
								))}
							</div>
						)}
					</div>
				)
			}

			{
				gallery && (
					<div class="cs-features">
						{gallery.map((shot) => (
							<figure class="cs-feature">
								<figcaption>
									{shot.title && <strong>{shot.title}</strong>}
									<span>{shot.caption}</span>
								</figcaption>
								<img src={shot.src} alt={shot.title ?? shot.caption} loading="lazy" style={shot.maxWidth ? `max-width: ${shot.maxWidth}px` : undefined} />
							</figure>
						))}
					</div>
				)
			}

			{
				liveLinks && (
					<div class="cs-live">
						<h2>See it live</h2>
						<p class="cs-live-note">The layers of a marketplace listing I design - live on the retailers.</p>
						<div class="cs-live-list">
							{liveLinks.map((item) => (
								<div class="cs-live-item">
									<strong>{item.title}</strong>
									<p>{item.body}</p>
									{item.url && item.url.startsWith("http") && (
										<a href={item.url} target="_blank" rel="noopener">
											{item.linkLabel ?? "View live"} <span aria-hidden="true">-></span>
										</a>
									)}
								</div>
							))}
						</div>
					</div>
				)
			}

			<div class="prose">
				<h2>Impact</h2>
				<p><strong>{study.impact}</strong></p>
			</div>

			{
				marketing && (
					<div class="cs-marketing">
						<p class="kicker">Marketing &amp; visual design</p>
						<h2>Beyond the store.</h2>
						<p class="cs-marketing-intro">{marketing.intro}</p>

						<div class="play-gallery mkt-gallery">
							{marketing.images.map((img) => (
								<button class="play-item" type="button" aria-label={`Open ${img.alt}`}>
									<span class="play-inner">
										<span class="play-frame">
											<img
												src={`/images/marketing/${marketing.dir}/thumbs/${img.slug}.webp`}
												alt={img.alt}
												width={img.w}
												height={img.h}
												loading="lazy"
												decoding="async"
											/>
										</span>
									</span>
								</button>
							))}
						</div>

						{marketing.callouts && (
							<div class="mkt-callouts">
								{marketing.callouts.map((c) => (
									<div class="mkt-callout">
										<strong>{c.title}</strong>
										<p>{c.body}</p>
									</div>
								))}
							</div>
						)}
					</div>
				)
			}

		</section>

		<nav class="study-wide study-next" aria-label="After this case study">
			<a href={`/work/${nextStudy.slug}/`}>
				<span class="portfolio-label">Next case study</span>
				<strong>{isFerrero ? "A product system for trades.org" : nextStudy.title} <span aria-hidden="true">→</span></strong>
			</a>
			<a href="/contact/" class="study-next-contact">
				<span class="portfolio-label">Have a project in mind?</span>
				<strong>Book a call <span aria-hidden="true">→</span></strong>
			</a>
		</nav>

		{
			(marketing || showcase) && (
				<div class="lightbox" id="lightbox" hidden>
					<button class="lb-close" type="button" aria-label="Close">&times;</button>
					<button class="lb-nav lb-prev" type="button" aria-label="Previous">&#8249;</button>
					<figure class="lb-stage">
						<img id="lb-img" src={lightboxPreview} alt="" loading="lazy" />
					</figure>
					<button class="lb-nav lb-next" type="button" aria-label="Next">&#8250;</button>
				</div>
			)
		}
	</main>
</Layout>

{
	marketing && (
		<script define:vars={{ items: marketing.images, dir: marketing.dir }}>
			const lb = document.getElementById("lightbox");
			const img = document.getElementById("lb-img");
			const triggers = [...document.querySelectorAll(".mkt-gallery .play-item")];
			let index = 0;
			let lastFocused = null;

			const ROW = 6;
			const GAP = 18;
			const layout = () => {
				for (const el of triggers) {
					const height = el.querySelector(".play-inner").getBoundingClientRect().height;
					if (!height) continue;
					el.style.gridRowEnd = `span ${Math.max(1, Math.ceil((height + GAP) / ROW))}`;
				}
			};
			layout();
			window.addEventListener("resize", layout);
			for (const el of triggers) {
				const image = el.querySelector("img");
				if (!image.complete) image.addEventListener("load", layout, { once: true });
			}

			const show = (i) => {
				index = (i + items.length) % items.length;
				const item = items[index];
				img.classList.remove("is-tall");
				img.onload = () => {
					if (img.naturalHeight / img.naturalWidth > 1.8) img.classList.add("is-tall");
				};
				img.src = `/images/marketing/${dir}/${item.slug}.webp`;
				img.alt = item.alt;
			};
			const open = (i) => {
				lastFocused = document.activeElement;
				show(i);
				lb.hidden = false;
				document.body.style.overflow = "hidden";
				lb.querySelector(".lb-close").focus();
			};
			const close = () => {
				lb.hidden = true;
				img.removeAttribute("src");
				document.body.style.overflow = "";
				lastFocused?.focus();
			};
			triggers.forEach((el, i) => el.addEventListener("click", () => open(i)));
			lb.querySelector(".lb-close").addEventListener("click", close);
			lb.querySelector(".lb-prev").addEventListener("click", () => show(index - 1));
			lb.querySelector(".lb-next").addEventListener("click", () => show(index + 1));
			lb.addEventListener("click", (event) => {
				if (event.target === lb || event.target.classList.contains("lb-stage")) close();
			});
			document.addEventListener("keydown", (event) => {
				if (lb.hidden) return;
				if (event.key === "Escape") close();
				if (event.key === "ArrowLeft") show(index - 1);
				if (event.key === "ArrowRight") show(index + 1);
			});
		</script>
	)
}

{
	showcase && (
		<script>
			const lb = document.getElementById("lightbox");
			const img = document.getElementById("lb-img");
			const triggers = [...document.querySelectorAll(".cs-showcase [data-lightbox]")];
			let index = 0;
			let lastFocused = null;

			const show = (i) => {
				index = (i + triggers.length) % triggers.length;
				const el = triggers[index];
				img.classList.remove("is-tall");
				img.onload = () => {
					if (img.naturalHeight / img.naturalWidth > 1.8) img.classList.add("is-tall");
				};
				img.src = el.dataset.full;
				img.alt = el.dataset.alt || "";
			};
			const open = (i) => {
				lastFocused = document.activeElement;
				show(i);
				lb.hidden = false;
				document.body.style.overflow = "hidden";
				lb.querySelector(".lb-close").focus();
			};
			const close = () => {
				lb.hidden = true;
				img.removeAttribute("src");
				document.body.style.overflow = "";
				lastFocused?.focus();
			};
			triggers.forEach((el, i) => el.addEventListener("click", () => open(i)));
			lb.querySelector(".lb-close").addEventListener("click", close);
			lb.querySelector(".lb-prev").addEventListener("click", () => show(index - 1));
			lb.querySelector(".lb-next").addEventListener("click", () => show(index + 1));
			lb.addEventListener("click", (event) => {
				if (event.target === lb || event.target.classList.contains("lb-stage")) close();
			});
			document.addEventListener("keydown", (event) => {
				if (lb.hidden) return;
				if (event.key === "Escape") close();
				if (event.key === "ArrowLeft") show(index - 1);
				if (event.key === "ArrowRight") show(index + 1);
			});
		</script>
	)
}

<style>
	.study-page {
		--study-gap: clamp(54px, 7vw, 88px);
	}

	.study-intro {
		padding-block: 40px 56px;
	}

	.study-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 12px;
		align-items: center;
		margin-bottom: 20px;
	}

	.study-breadcrumb a, .study-live-link {
		color: var(--pink);
		text-underline-offset: 4px;
	}

	.study-intro h1 {
		max-width: 1000px;
		margin: 0;
		font-size: clamp(30px, 4.4vw, 60px);
		line-height: .95;
		letter-spacing: -.04em;
		text-wrap: balance;
	}

	.study-lede {
		max-width: 65ch;
		margin: 22px 0 0;
		color: var(--secondary);
		font-size: clamp(17px, 1.6vw, 22px);
	}

	.study-live-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 18px;
		min-height: 44px;
		font-weight: 700;
	}

	.study-details {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		margin: clamp(26px, 3.45vw, 44px) 0 0;
		padding-top: 24px;
		border-top: 1.5px solid var(--hairline);
	}

	.study-details dt {
		margin-bottom: 6px;
		color: var(--pink);
		font: 12px ui-monospace, Menlo, monospace;
		text-transform: uppercase;
	}

	.study-details dd {
		margin: 0;
		line-height: 1.4;
	}

	.study-wide {
		width: min(calc(100% - 48px), 1232px);
		margin-inline: auto;
	}

	.study-mosaic {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2px;
		overflow: hidden;
		border-radius: 28px;
		background: var(--ground);
	}

	.study-mosaic img {
		width: 100%;
		height: 100%;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.study-cover {
		margin-block: 0;
	}

	.study-cover img {
		width: 100%;
		height: clamp(210px, 43vw, 560px);
		border-radius: 28px;
		object-fit: cover;
	}

	.study-metrics {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin-block: 24px 0;
	}

	.study-metrics > div {
		display: flex;
		flex-direction: column-reverse;
		justify-content: space-between;
		gap: 18px;
		min-height: 210px;
		padding: clamp(22px, 2.81vw, 36px);
		border-radius: 28px;
		background: var(--raised);
		color: var(--pink);
	}

	.study-metrics > div:first-child {
		background: var(--brand-wine);
		color: #fff;
	}

	.study-metrics > div:last-child {
		background: var(--on-wine);
		color: var(--brand-wine);
	}

	.study-metrics dt {
		color: var(--secondary);
		font-size: 18px;
	}

	.study-metrics > div:first-child dt {
		color: var(--on-wine);
	}

	.study-metrics > div:last-child dt {
		color: #5d4f53;
	}

	.study-metrics dd {
		margin: 0;
		font-size: clamp(64px, 8.59vw, 110px);
		font-weight: 700;
		line-height: .85;
		letter-spacing: -.05em;
	}

	.study-metrics > div:first-child dd {
		font-size: clamp(80px, 12vw, 152px);
	}

	.study-brief {
		display: grid;
		grid-template-columns: minmax(220px, .36fr) 1fr;
		gap: clamp(22px, 4.375vw, 56px);
		padding-block: var(--study-gap);
	}

	.study-brief h2, .study-workflow h2 {
		margin: 0;
		font-size: clamp(27px, 3vw, 38px);
		line-height: 1.04;
		letter-spacing: -.02em;
	}

	.study-brief p {
		max-width: 760px;
		margin: 0;
		font-size: clamp(18px, 1.875vw, 24px);
		line-height: 1.45;
		text-wrap: pretty;
	}

	.study-workflow {
		padding-bottom: var(--study-gap);
	}

	.study-workflow ol {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
