---
import Layout from "../../layouts/Layout.astro";
import { caseStudies, site } from "../../data/site";

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
const nextStudy = caseStudies[(caseStudies.findIndex((item) => item.slug === study.slug) + 1) % caseStudies.length];

const media = study as {
	cover?: string;
	coverPosition?: string;
	gallery?: { src: string; title?: string; caption: string; maxWidth?: number }[];
	liveLinks?: { title: string; body: string; linkLabel?: string; url?: string }[];
	marketing?: {
		dir: string;
		intro: string;
		images: { slug: string; alt: string; w: number; h: number }[];
		callouts?: { title: string; body: string }[];
	};
};
const cover = media.cover;
const coverPos = media.coverPosition ?? "center top";
const gallery = media.gallery;
const liveLinks = media.liveLinks;
const marketing = media.marketing;
---

<Layout
	title={`${study.title} - UX / CRO Case Study`}
	description={`${study.outcome} ${study.summary}`}
	path={`/work/${study.slug}/`}
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>{study.client}</p>
			<h1 class="page-title">{study.outcome}</h1>
			<p class="page-lede">{study.summary}</p>
			<div class="pill-row">
				{study.tags.map((tag) => <span class="pill">{tag}</span>)}
			</div>
		</section>

		{
			cover && (
				<section class="container cs-cover">
					<img src={cover} alt={`${study.client} - ${study.outcome}`} width="1600" loading="eager" style={`object-position: ${coverPos}`} />
				</section>
			)
		}

		<section class="container cs-meta" aria-label="Case study details">
			<div><span>Role</span><strong>{study.role}</strong></div>
			<div><span>Timeline</span><strong>{study.timeline}</strong></div>
			<div><span>Dates</span><strong>{study.period}</strong></div>
			<div><span>Tools</span><strong>{study.tools}</strong></div>
			<div>
				<span>Contact</span>
				<a class="text-link" href={`mailto:${site.email}`}>Discuss a project</a>
			</div>
		</section>

		<section class="container section tight cs-body">
			<div class="prose">
				<h2>The problem</h2>
				<p>{study.problem}</p>

				<h2>My process</h2>
				<ul>
					{study.process.map((step) => <li>{step}</li>)}
				</ul>

				<h2>The solution</h2>
				<p>{study.solution}</p>
			</div>

			{
				gallery && (
					<div class="cs-features">
						{gallery.map((shot) => (
							<figure class="cs-feature">
								<figcaption>
									{shot.title && <strong>{shot.title}</strong>}
									<span>{shot.caption}</span>
								</figcaption>
								<img src={shot.src} alt={shot.title ?? shot.caption} loading="lazy" style={shot.maxWidth ? `max-width: ${shot.maxWidth}px` : undefined} />
							</figure>
						))}
					</div>
				)
			}

			{
				liveLinks && (
					<div class="cs-live">
						<h2>See it live</h2>
						<p class="cs-live-note">The layers of a marketplace listing I design - live on the retailers.</p>
						<div class="cs-live-list">
							{liveLinks.map((item) => (
								<div class="cs-live-item">
									<strong>{item.title}</strong>
									<p>{item.body}</p>
									{item.url && item.url.startsWith("http") && (
										<a href={item.url} target="_blank" rel="noopener">
											{item.linkLabel ?? "View live"} <span aria-hidden="true">-></span>
										</a>
									)}
								</div>
							))}
						</div>
					</div>
				)
			}

			<div class="prose">
				<h2>Impact</h2>
				<p><strong>{study.impact}</strong></p>
			</div>

			{
				marketing && (
					<div class="cs-marketing">
						<p class="kicker">Marketing &amp; visual design</p>
						<h2>Beyond the store.</h2>
						<p class="cs-marketing-intro">{marketing.intro}</p>

						<div class="play-gallery mkt-gallery">
							{marketing.images.map((img) => (
								<button class="play-item" type="button" aria-label={`Open ${img.alt}`}>
									<span class="play-inner">
										<span class="play-frame">
											<img
												src={`/images/marketing/${marketing.dir}/thumbs/${img.slug}.webp`}
												alt={img.alt}
												width={img.w}
												height={img.h}
												loading="lazy"
												decoding="async"
											/>
										</span>
									</span>
								</button>
							))}
						</div>

						{marketing.callouts && (
							<div class="mkt-callouts">
								{marketing.callouts.map((c) => (
									<div class="mkt-callout">
										<strong>{c.title}</strong>
										<p>{c.body}</p>
									</div>
								))}
							</div>
						)}
					</div>
				)
			}

			<div class="actions cs-end">
				<a class="button" href={`/work/${nextStudy.slug}/`}>Next project <span aria-hidden="true">-></span></a>
				<a class="text-link" href="/work/">All work</a>
			</div>
		</section>

		{
			marketing && (
				<div class="lightbox" id="lightbox" hidden>
					<button class="lb-close" type="button" aria-label="Close">&times;</button>
					<button class="lb-nav lb-prev" type="button" aria-label="Previous">&#8249;</button>
					<figure class="lb-stage">
						<img id="lb-img" src="" alt="" />
					</figure>
					<button class="lb-nav lb-next" type="button" aria-label="Next">&#8250;</button>
				</div>
			)
		}
	</main>
</Layout>

{
	marketing && (
		<script define:vars={{ items: marketing.images, dir: marketing.dir }}>
			const lb = document.getElementById("lightbox");
			const img = document.getElementById("lb-img");
			const triggers = [...document.querySelectorAll(".mkt-gallery .play-item")];
			let index = 0;
			let lastFocused = null;

			const ROW = 6;
			const GAP = 18;
			const layout = () => {
				for (const el of triggers) {
					const height = el.querySelector(".play-inner").getBoundingClientRect().height;
					if (!height) continue;
					el.style.gridRowEnd = `span ${Math.max(1, Math.ceil((height + GAP) / ROW))}`;
				}
			};
			layout();
			window.addEventListener("resize", layout);
			for (const el of triggers) {
				const image = el.querySelector("img");
				if (!image.complete) image.addEventListener("load", layout, { once: true });
			}

			const show = (i) => {
				index = (i + items.length) % items.length;
				const item = items[index];
				img.classList.remove("is-tall");
				img.onload = () => {
					if (img.naturalHeight / img.naturalWidth > 1.8) img.classList.add("is-tall");
				};
				img.src = `/images/marketing/${dir}/${item.slug}.webp`;
				img.alt = item.alt;
			};
			const open = (i) => {
				lastFocused = document.activeElement;
				show(i);
				lb.hidden = false;
				document.body.style.overflow = "hidden";
				lb.querySelector(".lb-close").focus();
			};
			const close = () => {
				lb.hidden = true;
				img.src = "";
				document.body.style.overflow = "";
				lastFocused?.focus();
			};
			triggers.forEach((el, i) => el.addEventListener("click", () => open(i)));
			lb.querySelector(".lb-close").addEventListener("click", close);
			lb.querySelector(".lb-prev").addEventListener("click", () => show(index - 1));
			lb.querySelector(".lb-next").addEventListener("click", () => show(index + 1));
			lb.addEventListener("click", (event) => {
				if (event.target === lb || event.target.classList.contains("lb-stage")) close();
			});
			document.addEventListener("keydown", (event) => {
				if (lb.hidden) return;
				if (event.key === "Escape") close();
				if (event.key === "ArrowLeft") show(index - 1);
				if (event.key === "ArrowRight") show(index + 1);
			});
		</script>
	)
}
