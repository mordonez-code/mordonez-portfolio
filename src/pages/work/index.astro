---
import Layout from "../../layouts/Layout.astro";
import { caseStudies, site } from "../../data/site";
---

<Layout
	title="Work - eCommerce CRO & Design Case Studies"
	description="eCommerce and CRO design case studies by Mariana Ordonez: digital-shelf and marketplace design, PDP and A+ content, brand systems and conversion work."
	path="/work/"
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>UX / CRO design case studies</p>
			<h1 class="page-title">Case studies in eCommerce, CRO and brand design.</h1>
			<p class="page-lede">
				Real, shipped work across conversion-focused commerce, marketplace and PDP design,
				scalable design systems and brand creative.
			</p>
			<div class="pill-row" aria-label="Case study filters">
				<span class="pill">CRO</span>
				<span class="pill">AI Product</span>
				<span class="pill">UI/UX</span>
				<span class="pill">Design systems</span>
				<span class="pill">Brand</span>
			</div>
		</section>

		<section class="container section tight">
			<div class="work-list">
				{
					caseStudies.map((study) => {
					const media = study as { cover?: string; coverPosition?: string };
					const cover = media.cover;
					const coverPos = media.coverPosition ?? "center";
					return (
						<a class="card work-card" href={`/work/${study.slug}/`}>
							<div class="work-copy">
								<p class="kicker">{study.client} - {study.period}</p>
								<h2>{study.outcome}</h2>
								<p>{study.summary}</p>
								<div class="tags">
									{study.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
								<p class="metric">{study.impact}</p>
							</div>
							<div class={`work-art${cover ? " has-cover" : ""}`} aria-label={`${study.title} visual summary`}>
							{cover && <img src={cover} alt="" loading="lazy" style={`object-position: ${coverPos}`} />}
						</div>
						</a>
					);
					})
				}
			</div>
		</section>

		<section class="container cta-band">
			<h2>Want this kind of work on your product?</h2>
			<p>Send the role, product or funnel. I will reply in US business hours.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href="/">Back to home</a>
			</div>
		</section>
	</main>
</Layout>
