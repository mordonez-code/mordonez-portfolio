---
import { contactHref, site, socialLinks, web3formsAccessKey } from "../data/site";
import Layout from "../layouts/Layout.astro";

const profiles = socialLinks.filter(({ label }) => label === "LinkedIn" || label === "Behance");
const times = ["9:00 am", "10:30 am", "1:00 pm", "3:30 pm"];
---

<Layout
	title="Contact - Mariana Ordoñez"
	description="Get in touch with Mariana Ordoñez about ecommerce, product or marketing design roles and projects. Based in Bogotá, working US hours."
	path="/contact/"
>
	<main class="contact-page">
		<div class="contact-layout">
			<section class="contact-intro" aria-labelledby="contact-title">
				<h1 id="contact-title">Let's talk.</h1>
				<p class="contact-lede">
					Hiring, or have a project in mind? Request a 30-minute call. I’m happy to chat in English or Spanish.
				</p>
				<div class="contact-info">
					<dl>
						<div>
							<dt class="portfolio-label">Where</dt>
							<dd>Bogotá, Colombia<br />Remote, US hours</dd>
						</div>
						<div>
							<dt class="portfolio-label">Time zone</dt>
							<dd>UTC−5 year-round</dd>
						</div>
					</dl>
					<div class="contact-links">
						<a href={contactHref}>Email <span aria-hidden="true">↗</span></a>
						{profiles.map(({ label, url }) => (
							<a href={url} rel="me noopener" target="_blank">{label} <span aria-hidden="true">↗</span></a>
						))}
						<a href={site.resumeUrl}>Download CV <span aria-hidden="true">↓</span></a>
					</div>
				</div>
			</section>

			<section class="contact-panel" aria-labelledby="call-heading">
				<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
					<input type="hidden" name="access_key" value={web3formsAccessKey} />
					<input type="hidden" name="subject" value="Call request from mordonez.com" />
					<input type="hidden" name="from_name" value="mordonez.com contact form" />
					<input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

					<header>
						<h2 id="call-heading">Request a 30-min call</h2>
						<p>Share a preferred day and time if you have one. I’ll follow up by email to confirm.</p>
					</header>

					<div class="field date-field">
						<label for="cf-date">Preferred date <span>(optional)</span></label>
						<input id="cf-date" type="date" name="preferred_date" />
					</div>

					<div class="date-picker" hidden>
						<div class="calendar-header">
							<span class="portfolio-label">Preferred date <span>(optional)</span></span>
							<div class="calendar-controls">
								<button type="button" class="calendar-back" aria-label="Previous two weeks">‹</button>
								<span class="calendar-month" aria-live="polite"></span>
								<button type="button" class="calendar-forward" aria-label="Next two weeks">›</button>
							</div>
						</div>
						<div class="calendar-grid" role="group" aria-label="Preferred date">
							{["Mon", "Tue", "Wed", "Thu", "Fri"].map((day) => <span class="portfolio-label">{day}</span>)}
						</div>
					</div>

					<fieldset class="time-field">
						<legend class="portfolio-label">Preferred time · Eastern Time</legend>
						<div class="time-options">
							<label><input type="radio" name="preferred_time_eastern" value="Any time" checked /><span>Any time</span></label>
							{times.map((time) => (
								<label><input type="radio" name="preferred_time_eastern" value={time} /><span>{time}</span></label>
							))}
						</div>
					</fieldset>

					<div class="contact-fields">
						<div class="field">
							<label for="cf-name">Your name</label>
							<input id="cf-name" type="text" name="name" required autocomplete="name" />
						</div>
						<div class="field">
							<label for="cf-email">Work email</label>
							<input id="cf-email" type="email" name="email" required autocomplete="email" />
						</div>
						<div class="field contact-message">
							<label for="cf-message">What's the role or project?</label>
							<textarea id="cf-message" name="message" rows="3" required></textarea>
						</div>
					</div>

					<button class="portfolio-button" type="submit">Send call request <span aria-hidden="true">→</span></button>
					<p class="form-status" role="status" aria-live="polite"></p>
				</form>
			</section>
		</div>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>(".contact-form");
	const status = form?.querySelector<HTMLElement>(".form-status");
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!status || !button || button.disabled) return;

		status.className = "form-status";
		status.textContent = "Sending…";
		button.disabled = true;

		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});
			const result = await response.json();
			if (!response.ok || !result.success) throw new Error("Request failed");
			form.reset();
			status.classList.add("is-ok");
			status.textContent = "Thanks. Your request is on its way. I’ll reply by email to arrange the call.";
		} catch {
			status.classList.add("is-error");
			status.textContent = "Your request couldn’t be sent. Please try again or email me directly.";
		} finally {
			button.disabled = false;
		}
	});

	const dateField = form?.querySelector<HTMLInputElement>("#cf-date");
	const calendar = form?.querySelector<HTMLElement>(".date-picker");
	const dates = calendar?.querySelector<HTMLElement>(".calendar-grid");
	const month = calendar?.querySelector<HTMLElement>(".calendar-month");
	const back = calendar?.querySelector<HTMLButtonElement>(".calendar-back");
	const forward = calendar?.querySelector<HTMLButtonElement>(".calendar-forward");

	if (form && dateField && calendar && dates && month && back && forward) {
		const today = new Intl.DateTimeFormat("en-CA", {
			timeZone: "America/New_York", year: "numeric", month: "2-digit", day: "2-digit",
		}).format(new Date());
		const week = new Date(`${today}T12:00:00`);
		week.setDate(week.getDate() - (week.getDay() + 6) % 7);
		const localIsoDate = new Intl.DateTimeFormat("en-CA", {
			year: "numeric", month: "2-digit", day: "2-digit",
		});
		const dateLabel = new Intl.DateTimeFormat("en-US", { dateStyle: "full" });
		const monthLabel = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" });
		const weekDays = [0, 1, 2, 3, 4, 7, 8, 9, 10, 11];
		let offset = 0;

		const renderDates = () => {
			dates.querySelectorAll("button").forEach((day) => day.remove());
			const firstDay = new Date(week);
			firstDay.setDate(firstDay.getDate() + offset);
			const lastDay = new Date(firstDay);
			lastDay.setDate(lastDay.getDate() + 11);
			month.textContent = monthLabel.formatRange(firstDay, lastDay);
			back.disabled = offset === 0;

			for (const delta of weekDays) {
				const date = new Date(firstDay);
				date.setDate(date.getDate() + delta);
				const value = localIsoDate.format(date);
				const day = document.createElement("button");
				day.type = "button";
				day.dataset.date = value;
				day.textContent = String(date.getDate());
				day.disabled = value < today;
				day.setAttribute("aria-label", dateLabel.format(date));
				day.setAttribute("aria-pressed", String(value === dateField.value));
				dates.append(day);
			}
		};

		dates.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof HTMLButtonElement) || !target.dataset.date) return;
			dateField.value = dateField.value === target.dataset.date ? "" : target.dataset.date;
			dates.querySelectorAll("button").forEach((day) => {
				day.setAttribute("aria-pressed", String(day.dataset.date === dateField.value));
			});
		});
		back.addEventListener("click", () => {
			offset -= 14;
			renderDates();
			if (back.disabled) forward.focus();
		});
		forward.addEventListener("click", () => {
			offset += 14;
			renderDates();
		});
		form.addEventListener("reset", () => {
			offset = 0;
			queueMicrotask(renderDates);
		});

		if (!Number.isNaN(week.valueOf())) {
			dateField.min = today;
			renderDates();
			dateField.closest(".date-field")?.setAttribute("hidden", "");
			calendar.hidden = false;
		}
	}
</script>

<style>
	.contact-layout {
		width: min(calc(100% - 48px), 1232px);
		margin: 8px auto 24px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}
	.contact-intro,
	.contact-panel {
		border-radius: 28px;
		padding: clamp(24px, 3.75vw, 48px);
	}
	.contact-intro {
		display: flex;
		flex-direction: column;
		gap: 24px;
		background: var(--brand-wine);
		color: white;
	}
	.contact-intro h1 {
		margin: 0;
		font-size: clamp(64px, 9.4vw, 120px);
		letter-spacing: -.05em;
		line-height: .9;
	}
	.contact-lede {
		max-width: 440px;
		margin: 0;
		color: var(--on-wine);
		font-size: 20px;
	}
	.contact-info {
		margin-top: auto;
		padding-top: 24px;
		border-top: 1.5px solid #a6566e;
	}
	.contact-info dl {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin: 0 0 20px;
	}
	.contact-info dt {
		margin-bottom: 6px;
		color: var(--on-wine);
	}
	.contact-info dd { margin: 0; }
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 20px;
		font-weight: 600;
	}
	.contact-links a:hover { text-decoration: underline; }
	.contact-panel {
		padding: clamp(24px, 3.125vw, 40px);
		background: var(--raised);
	}
	.contact-form {
		max-width: none;
		gap: 22px;
	}
	.contact-form h2 { margin: 0; font-size: 28px; }
	.contact-form header p {
		margin: 8px 0 0;
		color: var(--secondary);
		font-size: 15px;
	}
	.contact-form .date-field[hidden] { display: none; }
	.calendar-header,
	.calendar-controls {
		display: flex;
		align-items: center;
	}
	.calendar-header {
		justify-content: space-between;
		gap: 8px 16px;
		flex-wrap: wrap;
		margin-bottom: 12px;
	}
	.calendar-controls { gap: 8px; max-width: 100%; }
	.calendar-controls button,
	.calendar-grid :global(button) {
		border: 1.5px solid var(--hairline);
		border-radius: 12px;
		color: white;
		background: var(--hover);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.calendar-controls button {
		flex: none;
		min-width: 44px;
		min-height: 44px;
		font-size: 22px;
	}
	.calendar-month {
		font-size: 14px;
		font-weight: 600;
		text-align: center;
	}
	.calendar-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
		text-align: center;
	}
	.calendar-grid :global(button) {
		justify-self: stretch;
		min-height: 44px;
	}
	.calendar-grid :global(button:not(:disabled):hover),
	.calendar-controls button:not(:disabled):hover {
		border-color: var(--pink);
	}
	.calendar-grid :global(button[aria-pressed="true"]) {
		border-color: var(--pink);
		background: var(--pink);
		color: var(--ground);
	}
	.calendar-grid :global(button:disabled),
	.calendar-controls button:disabled {
		opacity: .45;
		cursor: default;
	}
	.time-field {
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	.time-options {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
	}
	.time-options label { position: relative; }
	.time-options input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		padding: 0;
	}
	.time-options span {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		border: 1.5px solid var(--hairline);
		border-radius: 99px;
		padding: 8px 14px;
		color: white;
		cursor: pointer;
	}
	.time-options span:hover { border-color: var(--pink); }
	.time-options input:checked + span {
		background: var(--pink);
		color: var(--ground);
		border-color: var(--pink);
	}
	.time-options input:focus-visible + span { outline: 2px solid white; outline-offset: 3px; }
	.contact-fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	.contact-message { grid-column: 1 / -1; }
	.contact-form .field label { color: var(--secondary); }
	.contact-form .field :is(input, textarea) {
		min-width: 0;
		border: 1.5px solid var(--hairline);
		background: var(--ground);
		color: white;
	}
	.contact-form .field :is(input, textarea):focus {
		outline: 2px solid var(--pink);
		outline-offset: 2px;
		box-shadow: none;
	}
	.contact-form textarea { min-height: 84px; }
	.contact-form button[type="submit"] {
		width: 100%;
		min-height: 54px;
		gap: 6px;
	}
	.contact-form button[type="submit"]:disabled { opacity: .65; cursor: wait; }
	.contact-form .form-status:empty { position: absolute; margin: 0; min-height: 0; }
	.contact-form .form-status:not(:empty) { color: var(--on-wine); }
	@media (max-width: 820px) {
		.contact-layout { grid-template-columns: minmax(0, 1fr); }
		.contact-info { margin-top: 12px; }
	}
	@media (max-width: 470px) {
		.contact-layout { width: calc(100% - 32px); }
		.contact-fields { grid-template-columns: minmax(0, 1fr); }
		.calendar-grid { gap: 5px; }
	}
</style>
