---
import ClosingBand from "../components/ClosingBand.astro";
import PageIntro from "../components/PageIntro.astro";
import { playGallery, socialChannels, watercolors } from "../data/site";
import Layout from "../layouts/Layout.astro";

const featured = [
	"shiitake-mushroom", "bogota", "chemex", "nairo", "blossomed-heart", "oyster-tacos",
	"popsicle", "la-raqueta", "calm-palm", "dog-portrait", "shiitake-pizza", "two-riders",
	"bbq-sauce", "line-figure", "casabianca-coral", "pepairegui",
];
const artwork = [
	...featured.flatMap((slug) => playGallery.filter((item) => item.slug === slug)),
	...playGallery.filter(({ slug }) => !featured.includes(slug)),
];
const filters = {
	Illustration: [
		"shiitake-mushroom", "portobello-mushroom", "oyster-mushroom", "melena-de-leon",
		"bbq-sauce", "fried-chicken", "chili", "popsicle", "potted-plant", "washing-dishes",
		"dog-portrait", "line-figure", "two-riders", "potv",
	],
	Type: ["shiitake-mushroom", "portobello-mushroom", "oyster-tacos", "shiitake-pizza", "bogota", "pepairegui"],
	Motion: ["oyster-tacos", "popsicle", "washing-dishes"],
	Print: [
		"shiitake-pizza", "chemex", "brewing-methods", "calm-palm", "sequoia", "bogota",
		"blossomed-heart", "la-raqueta", "nairo",
	],
};
const shop = "https://tienda.mordonez.com/";
---

<Layout
	title="Play · Illustration & Visual Experiments"
	description="Illustration, type, motion and hand-painted watercolour studies by Mariana Ordoñez."
	path="/play/"
>
	<main class="play-page">
		<PageIntro
			word="Play"
			label="Illustration and visual experiments"
			title="Where I keep my hands warm."
			description="Watercolour, illustration, type, motion and side projects. The human craft behind the product and commerce work."
		/>

		<section class="portfolio-light watercolour-band" aria-labelledby="watercolour-title">
			<div class="container">
				<header class="play-split">
					<div>
						<p class="portfolio-label">01 · Watercolour studies</p>
						<h2 id="watercolour-title" class="portfolio-heading">Painted by hand.</h2>
					</div>
					<p>Botanical studies in watercolour on paper. No undo, no layers. The analog end of the same curiosity.</p>
				</header>
				<div class="watercolour-grid">
					{watercolors.map((item, index) => (
						<a class="gallery-item" href={`/play/${item.slug}.webp`} data-gallery-image>
							<img
								src={`/play/thumbs/${item.slug}.webp`}
								alt={item.alt}
								width={item.width}
								height={item.height}
								loading="lazy"
								decoding="async"
							/>
							<span class="watercolour-caption" aria-hidden="true">
								{item.title}
								<span>{String(index + 1).padStart(2, "0")}</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="digital-title">
			<header class="play-filter-header">
				<div>
					<p class="portfolio-label">02 · Digital work</p>
					<h2 id="digital-title" class="portfolio-heading">Illustration, type and motion.</h2>
				</div>
				<div class="portfolio-chips play-filters" role="group" aria-label="Filter digital work" hidden>
					<button type="button" data-play-filter="All" aria-controls="digital-wall" aria-pressed="true">All · {artwork.length}</button>
					{Object.keys(filters).map((filter) => (
						<button type="button" data-play-filter={filter} aria-controls="digital-wall" aria-pressed="false">{filter}</button>
					))}
				</div>
			</header>
			<div class="digital-wall" id="digital-wall">
				{artwork.map((item, index) => (
					<a
						class="gallery-item"
						href={`/play/${item.slug}.webp`}
						data-gallery-image
						data-genres={Object.entries(filters).filter(([, slugs]) => slugs.includes(item.slug)).map(([genre]) => genre).join(" ")}
						data-extra={index >= featured.length ? "" : undefined}
					>
						<img
							src={`/play/thumbs/${item.slug}.webp`}
							alt={item.alt}
							width={item.width}
							height={item.height}
							loading="lazy"
							decoding="async"
						/>
					</a>
				))}
			</div>
			<button class="show-artwork" type="button" aria-controls="digital-wall" aria-expanded="false" data-show-artwork hidden>
				Show all {artwork.length} pieces <span aria-hidden="true">↓</span>
			</button>
			<p class="play-status" role="status"></p>
		</section>

		<section class="container portfolio-section" aria-labelledby="social-title">
			<header class="play-split">
				<div>
					<p class="portfolio-label">03 · Social and content</p>
					<h2 id="social-title" class="portfolio-heading">Painting in public.</h2>
				</div>
				<p>I plan, shoot, edit and post my own content. It is the same work I do for brands, with my own paintings as the product.</p>
			</header>
			<div class="play-social">
				{socialChannels.map((channel) => (
					<a class="play-social-card" href={channel.url} target="_blank" rel="me noopener">
						<img
							src={channel.image}
							alt={channel.alt}
							width={channel.width}
							height={channel.height}
							loading="lazy"
							decoding="async"
						/>
						<p class="portfolio-label">{channel.platform} · {channel.handle}</p>
						<h3>{channel.title}</h3>
						<p>{channel.body}</p>
						<div class="portfolio-chips">{channel.tags.map((tag) => <span>{tag}</span>)}</div>
					</a>
				))}
			</div>
		</section>

		<ClosingBand
			title="Take one home."
			description="Cards, downloads and original watercolours. Most of what you just scrolled through lives in my shop (in Spanish)."
			primaryLabel="Visit the shop ↗"
			primaryHref={shop}
			secondaryLabel="See conversion work →"
			secondaryHref="/work/"
		/>

		<dialog class="play-viewer" aria-label="Artwork viewer">
			<button class="viewer-close" type="button" aria-label="Close" autofocus>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
			<button class="viewer-previous" type="button" aria-label="Previous artwork">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
			</button>
			<figure></figure>
			<button class="viewer-next" type="button" aria-label="Next artwork">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
			</button>
		</dialog>
	</main>
</Layout>

<script>
	const filters = document.querySelector<HTMLElement>(".play-filters");
	const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-play-filter]")];
	const wall = document.querySelector("#digital-wall");
	const tiles = [...document.querySelectorAll<HTMLAnchorElement>("#digital-wall .gallery-item")];
	const showArtwork = document.querySelector<HTMLButtonElement>("[data-show-artwork]");
	const status = document.querySelector<HTMLElement>(".play-status");
	let activeFilter = "All";
	let expanded = false;

	function filterArtwork(announce = true) {
		let shown = 0;
		for (const tile of tiles) {
			tile.hidden = activeFilter === "All"
				? !expanded && tile.hasAttribute("data-extra")
				: !tile.dataset.genres?.split(" ").includes(activeFilter);
			if (!tile.hidden) shown += 1;
		}

		for (const button of filterButtons) {
			button.setAttribute("aria-pressed", String(button.dataset.playFilter === activeFilter));
		}

		if (showArtwork) {
			showArtwork.hidden = activeFilter !== "All" || expanded;
			showArtwork.setAttribute("aria-expanded", String(expanded));
		}
		if (announce && status) status.textContent = `${shown} pieces shown`;
	}

	if (filters) filters.hidden = false;
	filterArtwork(false);

	for (const button of filterButtons) {
		button.addEventListener("click", () => {
			activeFilter = button.dataset.playFilter ?? "All";
			filterArtwork();
		});
	}

	showArtwork?.addEventListener("click", () => {
		expanded = true;
		filterArtwork();
		wall?.querySelector<HTMLElement>("[data-extra]")?.focus();
	});

	const viewer = document.querySelector<HTMLDialogElement>(".play-viewer");
	const stage = viewer?.querySelector("figure");
	const image = new Image();
	const artworkLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-gallery-image]")];
	let openLinks: HTMLAnchorElement[] = [];
	let selected = 0;

	// The viewer follows the current gallery order and skips filtered pieces.
	function show(index: number) {
		if (!openLinks.length) return;

		selected = (index + openLinks.length) % openLinks.length;
		const link = openLinks[selected];
		image.src = link.href;
		image.alt = link.querySelector("img")?.alt ?? "";
		if (!image.isConnected) stage?.append(image);
	}

	for (const link of artworkLinks) {
		link.addEventListener("click", (event) => {
			if (!viewer || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			event.preventDefault();
			openLinks = artworkLinks.filter((item) => !item.hidden);
			show(openLinks.indexOf(link));
			viewer.showModal();
		});
	}

	viewer?.querySelector(".viewer-close")?.addEventListener("click", () => viewer.close());
	viewer?.querySelector(".viewer-previous")?.addEventListener("click", () => show(selected - 1));
	viewer?.querySelector(".viewer-next")?.addEventListener("click", () => show(selected + 1));
	viewer?.addEventListener("click", (event) => {
		if (event.target === viewer || event.target === stage) viewer.close();
	});
	viewer?.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") show(selected - 1);
		if (event.key === "ArrowRight") show(selected + 1);
	});
</script>

<style>
	.play-page {
		--intro-bottom: 72px;
	}

	.play-page :global(.portfolio-intro h1) {
		font-size: clamp(2.5rem, 4.375vw, 3.5rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.play-page :global(.closing-copy h2) {
		font-size: clamp(2.65rem, 7.5vw, 6rem);
	}

	.watercolour-band {
		background: #fff;
		color: var(--deep);
		padding-block: clamp(48px, 7vw, 88px);
	}

	.play-split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 48px;
		align-items: end;
		margin-bottom: clamp(24px, 3.2vw, 40px);
	}

	.play-page h2 {
		margin: 0;
		font-size: clamp(40px, 5.625vw, 72px);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.play-page .portfolio-label {
		margin: 0 0 12px;
	}

	.play-split > p {
		margin: 0;
		color: var(--secondary);
		font-size: 18px;
		line-height: 1.5;
	}

	.watercolour-band .portfolio-label {
		color: var(--brand-wine);
	}

	.watercolour-band .play-split > p {
		color: #5d4f53;
	}

	.watercolour-grid,
	.play-social {
		display: grid;
		gap: 20px;
	}

	.watercolour-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.gallery-item {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.gallery-item[hidden],
	.play-filters[hidden],
	.show-artwork[hidden] {
		display: none;
	}

	.gallery-item img {
		display: block;
		width: 100%;
		border-radius: 16px;
		height: auto;
	}

	.gallery-item:hover img {
		filter: brightness(0.93);
	}

	.watercolour-grid .gallery-item img {
		border-radius: 20px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: #f4f2f3;
	}

	.watercolour-caption {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
		margin-top: 12px;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.watercolour-caption > span {
		color: var(--brand-wine);
		font: 12px ui-monospace, Menlo, monospace;
		letter-spacing: normal;
	}

	.play-filter-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 20px 32px;
		margin-bottom: 36px;
	}

	.play-filter-header > div:first-child {
		flex: 1 1 470px;
		max-width: 640px;
	}

	.play-filters button {
		min-height: 44px;
		padding: 10px 18px;
		border: 1.5px solid var(--hairline);
		border-radius: 99px;
		cursor: pointer;
		color: inherit;
		background: transparent;
		font-size: 15px;
		font-weight: 600;
	}

	.play-filters button:hover {
		background: var(--hover);
	}

	.play-filters button[aria-pressed="true"] {
		color: var(--ground);
		background: var(--pink);
		border-color: var(--pink);
	}

	.digital-wall {
		columns: 4;
		column-gap: 16px;
	}

	.digital-wall .gallery-item {
		break-inside: avoid;
		margin-bottom: 16px;
	}

	.digital-wall img {
		background: var(--raised);
	}

	.show-artwork {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		min-height: 64px;
		margin-top: 8px;
		border: 1.5px solid currentColor;
		border-radius: 99px;
		color: var(--ink);
		background: transparent;
		font-size: 17px;
		font-weight: 700;
		cursor: pointer;
	}

	.show-artwork:hover {
		color: var(--deep);
		background: #fff;
	}

	.play-status {
		position: absolute;
		clip-path: inset(50%);
		width: 1px;
		height: 1px;
		margin: 0;
		overflow: hidden;
		white-space: nowrap;
	}

	.play-social {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.play-social-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: clamp(20px, 3vw, 32px);
		border-radius: 28px;
		background: var(--raised);
		color: var(--ink);
		text-decoration: none;
	}

	.play-social-card:first-child {
		background: var(--brand-wine);
		--secondary: var(--on-wine);
		--hairline: var(--on-wine);
	}

	.play-social-card:hover h3 {
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.play-social-card img {
		width: 100%;
		height: clamp(132px, 20.32vw, 260px);
		border-radius: 16px;
		object-fit: contain;
		background: var(--ground);
	}

	.play-social-card h3 {
		margin: 0;
		font-size: clamp(30px, 3.125vw, 40px);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.play-social-card p,
	.play-social-card .portfolio-label {
		color: var(--secondary);
		margin: 0;
	}

	.play-social-card .portfolio-label {
		overflow-wrap: anywhere;
	}

	.play-social-card .portfolio-chips {
		margin-top: auto;
	}

	.play-viewer {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		border: 0;
		padding: 56px 24px;
		background: transparent;
		color: #fff;
	}

	.play-viewer[open] {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 12px;
		align-items: center;
	}

	.play-viewer::backdrop {
		background: rgb(23 15 18 / 96%);
	}

	:global(html:has(.play-viewer[open])) {
		overflow: hidden;
	}

	.play-viewer figure {
		display: grid;
		place-items: center;
		margin: 0;
		height: 100%;
		min-height: 0;
	}

	.play-viewer :global(img) {
		display: block;
		max-width: 100%;
		max-height: calc(100dvh - 112px);
		border-radius: 12px;
		object-fit: contain;
	}

	.play-viewer button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--hairline);
		border-radius: 50%;
		background: var(--deep-raised);
		color: #fff;
		cursor: pointer;
	}

	.play-viewer button:hover {
		background: var(--brand-wine);
	}

	.viewer-close {
		position: absolute;
		top: 12px;
		right: 16px;
	}

	@media (max-width: 900px) {
		.digital-wall { columns: 3; }
		.play-split { gap: 24px; }
	}

	@media (max-width: 650px) {
		.play-split,
		.play-social {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.watercolour-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.watercolour-caption { font-size: 16px; }
		.digital-wall { columns: 2; }

		.play-viewer[open] {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: minmax(0, 1fr) auto;
		}

		.play-viewer figure {
			grid-row: 1;
			grid-column: 1 / -1;
		}

		.play-viewer :global(img) { max-height: calc(100dvh - 170px); }
		.viewer-previous { justify-self: end; }
	}
</style>
