---
import ClosingBand from "../components/ClosingBand.astro";
import Layout from "../layouts/Layout.astro";
import { caseStudies, site } from "../data/site";
import { getJournalArticles } from "../lib/journal.server";

const brands = ["Ferrero", "Nutella", "Kinder", "Tic Tac", "Butterfinger", "Crunch", "Keebler", "Royal Dansk", "Casabianca", "trades.org"];
const process = [
	["Audit the shelf", "Compare competitors, reviews and search results side by side."],
	["Generate with AI", "Explore layout, imagery and copy variants in fast rounds."],
	["Refine by hand", "Check brand rules and thumbnail legibility, then polish in Figma."],
	["Test and ship", "Use shopper behavior to decide which version to ship."],
];
const selected = [
	{
		slug: "estore-labs-marketplace-cro",
		title: "The Ferrero digital shelf",
		meta: "Estore Labs · Marketplace, A+ content · 2024–now",
		metric: "3",
		unit: "US marketplaces",
		image: "/case-studies/estore-labs/shelf/fr-ec1.webp",
	},
	{
		slug: "trades-design-system-cms",
		title: "A product system for trades.org",
		meta: "Product, UI/UX, CMS/ATS · 2022–23",
		metric: "1 sys",
		image: "/case-studies/trades-org/designsystem.webp",
	},
	{
		slug: "casabianca-apparel-cro",
		title: "Casabianca Cycling’s Shopify store",
		meta: "CRO, UI/UX, brand system · 2018–22",
		metric: "4 yrs",
		image: "/case-studies/casabianca-cycling/cover.webp",
	},
].filter((project) => caseStudies.some((study) => study.slug === project.slug));
const metrics = [
	["8", "years designing for ecommerce"],
	["12+", "consumer brands designed for"],
	["4 yrs", "designing and refining a Shopify storefront"],
	["3", "US marketplaces: Amazon, Walmart, Instacart"],
];
const career = [
	["2024 – now", "Digital Shelf Designer", "Estore Labs · Ferrero USA brands"],
	["2022 – 23", "UX/UI Product Designer", "trades.org"],
	["2018 – 22", "Ecommerce Designer", "Casabianca Cycling"],
];
const skills = ["Figma", "AI coding agents", "Shopify", "Amazon A+", "A/B testing", "Design tokens", "Email & paid social"];
const articleOrder = ["ai-ab-tests-faster-design-craft", "trustworthy-ai-interfaces", "high-converting-product-detail-page"];
const articles = await getJournalArticles();
const journal = [...articleOrder.flatMap((slug) => articles.filter((article) => article.slug === slug)), ...articles.filter((article) => !articleOrder.includes(article.slug))].slice(0, 3);
const workflowHref = articles.some(({ slug }) => slug === articleOrder[0]) ? `/journal/${articleOrder[0]}/` : "/journal/";
const links = [
	{ title: "Tools", description: "Free resources I built for designers.", href: "/tools/" },
	{ title: "Play", description: "Watercolor and visual experiments.", href: "/play/" },
	{ title: "My Shopify store", description: "An art store I designed and coded with AI agents.", href: "https://tienda.mordonez.com/" },
];
---

<Layout
	title="Mariana Ordoñez · AI-accelerated Ecommerce & Product Designer"
	description="Mariana Ordoñez is an AI-accelerated designer for ecommerce and product. See her work across marketplaces, Shopify and product design systems."
	path="/"
>
	<main>
		<section class="container home-intro" aria-labelledby="home-title">
			<span class="hero-number" aria-hidden="true">12+</span>
			<div class="hero-message">
				<h1 id="home-title"><span class="accessible-number">12+ </span>consumer brands trust my design to sell.</h1>
				<p>I’m Mariana, an AI-accelerated designer for ecommerce and product.</p>
			</div>
			<img class="hero-portrait" src="/brand/mariana-portrait.webp" alt="Mariana Ordoñez" width="900" height="1125" fetchpriority="high" />
			<div class="hero-actions">
				<p><span aria-hidden="true"></span>Open to work · Remote, US hours</p>
				<a class="portfolio-button" href="/contact/">Book a call <span aria-hidden="true">→</span></a>
				<a class="work-link" href="#work">See the work <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<div class="brand-strip">
			<ul class="container" aria-label="Selected brands and teams">
				{brands.map((brand) => <li>{brand}</li>)}
			</ul>
		</div>

		<section class="container portfolio-section strengths" aria-labelledby="workflow">
			<div class="portfolio-card workflow-card">
				<div>
					<h2 id="workflow">AI speed.<br />Designer’s taste.</h2>
					<p class="portfolio-label strength-label">01 · How I work</p>
					<p>AI generates options for layouts, imagery and copy. I refine the strongest ideas in Figma and use shopper behavior to decide what to ship.</p>
					<a href={workflowHref}>Read how I do it <span aria-hidden="true">→</span></a>
				</div>
				<figure class="workflow-media">
					<img src="/mockups/ecommerce-ab-a.webp" alt="Variant A, Butterfinger product hero on white" width="480" height="480" loading="lazy" />
					<img src="/mockups/ecommerce-ab-b.webp" alt="Variant B, Butterfinger product hero with benefit callouts" width="480" height="480" loading="lazy" />
					<figcaption>Product hero concepts for an A/B test</figcaption>
				</figure>
			</div>
			<div class="strength-pair">
				<article class="portfolio-card">
					<h3>Creative that wins the thumbnail.</h3>
					<p class="portfolio-label strength-label">02 · Ecommerce</p>
					<p>Marketplace hero images, A+ content, Brand Stores, Shopify product pages, email and paid social.</p>
				</article>
				<article class="portfolio-card">
					<h3>One system, every screen on-brand.</h3>
					<p class="portfolio-label strength-label">03 · Product</p>
					<p>Figma systems, design tokens, UX foundations and responsive templates for web products.</p>
				</article>
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="process-title">
			<div class="portfolio-heading"><h2 id="process-title">From brief to winning variant.</h2></div>
			<ol class="process-grid">
				{process.map(([title, description], index) => (
					<li>
						<span class="process-number" aria-hidden="true">0{index + 1}</span>
						<h3>{title}</h3>
						<p>{description}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="container portfolio-section" id="work" aria-labelledby="work-title">
			<div class="portfolio-heading">
				<h2 id="work-title">Selected work</h2>
				<a class="home-link" href="/work/">All work <span aria-hidden="true">→</span></a>
			</div>
			<div class="home-projects">
				{selected.map(({ slug, title, meta, metric, image, unit }) => (
					<a class="home-project" href={`/work/${slug}/`}>
						<div class="project-metric"><strong>{metric}</strong>{unit && <small>{unit}</small>}</div>
						<div><h3>{title}</h3><p>{meta}</p></div>
						<img src={image} alt="" width="260" height="120" loading="lazy" />
						<span class="project-arrow" aria-hidden="true">→</span>
					</a>
				))}
			</div>
		</section>

		<section class="portfolio-light home-numbers" aria-label="Experience in numbers">
			<dl class="container">
				{metrics.map(([value, name]) => <div><dt>{name}</dt><dd>{value}</dd></div>)}
			</dl>
		</section>

		<section class="container portfolio-section" aria-labelledby="craft-title">
			<div class="portfolio-heading"><h2 id="craft-title">Beyond the screen</h2></div>
			<div class="home-craft">
				<a class="portfolio-card craft-feature" href="/play/">
					<img src="/play/thumbs/orchid.webp" alt="Mariana’s watercolor study of an orchid" width="700" height="700" loading="lazy" />
					<div><h3>Watercolor, by hand.</h3><p>Botanical studies, illustrated recipes and personal projects.</p><span>Visit the gallery →</span></div>
				</a>
				<a class="portfolio-card craft-small" href="/work/mariana-ordonez-shopify-store/"><h3>Turning art into a storefront</h3><p>How I designed and built a Shopify store for originals, cards and commissions.</p></a>
				<a class="portfolio-card craft-small" href="/about/"><h3>Brand and visual design</h3><p>Identity, product imagery and campaigns across food, drink and lifestyle.</p></a>
			</div>
		</section>

		<section class="container portfolio-section" aria-labelledby="career-title">
			<div class="portfolio-heading">
				<h2 id="career-title">Career</h2>
				<a class="home-link" href={site.resumeUrl}>Full CV <span aria-hidden="true">↓</span></a>
			</div>
			<div class="career-grid">
				{career.map(([period, title, employer]) => (
					<article class="portfolio-card career-card">
						<h3>{title}</h3>
						<p class="career-date">{period}</p>
						<p>{employer}</p>
					</article>
				))}
			</div>
			<div class="portfolio-chips home-skills">
				{skills.map((skill) => <span>{skill}</span>)}
				<a href="/about/#certification">IBM · Gen AI for UX</a>
			</div>
		</section>

		<section class="container portfolio-section home-journal" aria-labelledby="journal-title">
			<div>
				<div class="portfolio-heading">
					<h2 id="journal-title">Journal</h2>
					<a class="home-link" href="/journal/">Read all <span aria-hidden="true">→</span></a>
				</div>
				<ul>
					{journal.map((article) => (
						<li><a href={`/journal/${article.slug}/`}><span>{article.title}</span><span class="portfolio-label">{article.category.replaceAll(", ", " · ")}</span></a></li>
					))}
				</ul>
			</div>
			<div class="home-crosslinks">
				{links.map(({ title, description, href }) => (
					<a class="portfolio-card" href={href}><strong>{title} <span aria-hidden="true">{href.startsWith("https") ? "↗" : "→"}</span></strong><p>{description}</p></a>
				))}
			</div>
		</section>

		<ClosingBand
			title="Let’s talk about your next launch."
			description="Open to remote ecommerce, product and marketing design roles. I work US hours from Bogotá, in English or Spanish."
			portrait="/brand/mariana-portrait.webp"
			secondaryLabel="Download CV ↓"
			secondaryHref={site.resumeUrl}
		/>
	</main>
</Layout>

<style>
	.home-intro {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1fr);
		column-gap: 24px;
		align-items: end;
		padding-top: 24px;
		overflow: hidden;
	}
	/* The number gets its own row so the portrait no longer covers it; the
	   portrait only tucks under the bottom edge of the digits. */
	.hero-number {
		position: relative;
		z-index: -1;
		grid-area: 1 / 1 / 2 / -1;
		justify-self: center;
		color: var(--brand-wine);
		font-size: clamp(170px, 27vw, 360px);
		font-weight: 700;
		line-height: .8;
		letter-spacing: -.07em;
	}
	.hero-message { grid-area: 2 / 1; }
	.hero-actions { grid-area: 2 / 3; }
	.hero-portrait {
		grid-area: 2 / 2;
		margin-top: clamp(-40px, -2.5vw, -12px);
		width: min(100%, 360px);
		height: auto;
		aspect-ratio: 400 / 540;
		object-fit: cover;
		object-position: center top;
		border-radius: 100vw;
		justify-self: center;
	}
	.hero-message, .hero-actions { margin-bottom: 48px; }
	.hero-message h1 {
		font-size: clamp(1.9rem, 3.4375vw, 2.75rem);
		line-height: 1;
		letter-spacing: -.03em;
		max-width: 360px;
	}
	.accessible-number {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.hero-message p { margin: 16px 0 0; color: var(--secondary); }
	.hero-actions { display: grid; justify-items: end; gap: 14px; text-align: right; }
	.hero-actions p { margin: 0; color: var(--pink); font-size: 13px; font-weight: 600; }
	.hero-actions p span { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: currentColor; margin-inline-end: 6px; vertical-align: 1px; }
	.hero-actions .portfolio-button { padding: 15px 28px; }
	.work-link, .home-link, .workflow-card a { font-weight: 700; text-underline-offset: .25em; text-decoration: none; }
	:is(.work-link, .home-link, .workflow-card a):hover { text-decoration: underline; }
	.home-link { color: var(--pink); }
	.brand-strip { border-block: 1.5px solid var(--hairline); }
	.brand-strip ul { padding: 22px 0; list-style: none; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; font-size: 18px; font-weight: 700; line-height: 1.25; }
	.workflow-card { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; padding: clamp(24px, 3.4375vw, 44px); background: var(--brand-wine); }
	.workflow-card > div, .strength-pair article, .career-card { display: flex; flex-direction: column; }
	.workflow-card h2 { margin: 0; font-size: clamp(2.5rem, 5vw, 4rem); line-height: .95; letter-spacing: -.04em; }
	.workflow-card p, .strength-pair p, .process-grid p, .home-project p, .home-crosslinks p, .career-card p, .home-craft p { margin: 0; color: var(--secondary); }
	.workflow-card p, .workflow-card .strength-label { color: var(--on-wine); }
	.strength-label { order: -1; }
	.workflow-card p.strength-label, .strength-pair p.strength-label { margin-bottom: 14px; }
	.workflow-card h2 + p + p { margin-top: 18px; font-size: 18px; }
	.workflow-card a { margin-top: 18px; width: fit-content; }
	.workflow-media { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; padding: 18px; border-radius: 18px; background: #8d3550; }
	.workflow-media img { width: 100%; height: auto; border-radius: 10px; }
	.workflow-media figcaption { grid-column: 1 / -1; color: var(--on-wine); font-size: 13px; }
	.strength-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
	.strength-pair article { padding: clamp(24px, 2.8125vw, 36px); }
	.strength-pair h3 { margin: 0 0 12px; font-size: clamp(1.5rem, 2.65625vw, 2.125rem); line-height: 1.05; letter-spacing: -.02em; }
	.strength-pair .strength-label { color: var(--pink); }
	.process-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5px; margin: 0; padding: 1.5px; list-style: none; background: var(--hairline); }
	.process-grid li { padding: clamp(16px, 2.1875vw, 28px); background: var(--ground); }
	.process-grid li:nth-child(2) { background: var(--brand-wine); }
	.process-grid li:nth-child(2) p { color: var(--on-wine); }
	.process-grid li:nth-child(2) .process-number { color: var(--ink); }
	.process-number { display: block; color: var(--pink); font-size: clamp(2.25rem, 4.375vw, 3.5rem); font-weight: 700; line-height: 1; letter-spacing: -.04em; }
	.process-grid h3 { margin: 14px 0 8px; font-size: 20px; }
	.process-grid p { font-size: 15px; }
	#work { scroll-margin-top: 20px; }
	.home-projects { border-bottom: 1.5px solid var(--hairline); }
	.home-project { display: grid; grid-template-columns: minmax(112px, 200px) minmax(0, 1fr) minmax(0, 260px) 40px; gap: clamp(12px, 2.1875vw, 28px); align-items: center; padding: 28px 0; border-top: 1.5px solid var(--hairline); text-decoration: none; }
	.home-project:hover h3 { color: var(--pink); }
	.home-project img { width: 100%; height: 120px; object-fit: cover; border-radius: 12px; }
	.home-project h3 { margin: 0; font-size: clamp(1.25rem, 2.1875vw, 1.75rem); line-height: 1.18; letter-spacing: -.02em; }
	.home-project p { margin-top: 4px; font-size: 15px; }
	.project-metric { display: grid; gap: 4px; color: var(--pink); }
	.project-metric strong { font-size: clamp(2rem, 5vw, 4rem); line-height: 1; letter-spacing: -.04em; white-space: nowrap; }
	.project-arrow { justify-self: end; font-size: 28px; }
	.home-numbers { margin-top: var(--section-gap); }
	.home-numbers dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 32px; padding-block: clamp(40px, 5.625vw, 72px); }
	.home-numbers dl > div { display: flex; flex-direction: column-reverse; justify-content: start; }
	.home-numbers dt { margin-top: 10px; color: var(--secondary); }
	.home-numbers dd { margin: 0; color: var(--brand-wine); font-size: clamp(2.9rem, 8.75vw, 7rem); line-height: .9; font-weight: 700; letter-spacing: -.05em; white-space: nowrap; }
	.home-craft { display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: 1fr 1fr; gap: 20px; }
	.home-craft a { text-decoration: none; }
	.craft-feature { grid-row: span 2; display: grid; grid-template-columns: minmax(0, .8fr) 1fr; align-items: center; gap: 22px; padding: clamp(20px, 2.5vw, 32px); background: var(--brand-wine); }
	.craft-feature img { width: 100%; height: auto; border-radius: 12px; }
	.craft-feature span { display: inline-block; margin-top: 14px; font-weight: 700; }
	.craft-feature p { color: var(--on-wine); }
	.craft-small { padding: clamp(20px, 2.5vw, 32px); }
	.home-craft h3 { margin: 0 0 6px; font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.12; }
	.craft-small:hover, .home-crosslinks a:hover { background: var(--hover); }
	.craft-feature:hover, .home-crosslinks a:last-child:hover { background: #4f1125; }
	.career-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
	.career-card { padding: clamp(20px, 2.5vw, 32px); }
	.career-card:first-child { background: var(--pink); color: var(--ground); }
	.career-card:first-child :is(h3, p) { color: inherit; }
	.career-card h3 { margin: 26px 0 4px; font-size: 22px; line-height: 1.2; }
	.career-card p.career-date { order: -1; color: var(--pink); font-size: clamp(1.6rem, 3.4375vw, 2.75rem); line-height: 1; font-weight: 700; letter-spacing: -.04em; }
	.career-card:first-child p.career-date { color: var(--ground); }
	.home-skills { margin-top: 20px; }
	.home-skills a { color: var(--pink); border-color: var(--pink); text-decoration: none; }
	.home-journal { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; }
	.home-journal ul { margin: 0; padding: 0; list-style: none; border-bottom: 1.5px solid var(--hairline); }
	.home-journal li a { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-top: 1.5px solid var(--hairline); padding: 22px 0; text-decoration: none; font-size: 22px; font-weight: 600; line-height: 1.2; letter-spacing: -.01em; }
	.home-journal li a:hover { color: var(--pink); }
	.home-journal li a .portfolio-label { flex: 0 0 auto; max-width: 32%; }
	.home-crosslinks { display: grid; gap: 14px; align-content: start; }
	.home-crosslinks a { display: block; border-radius: 20px; padding: 24px; text-decoration: none; }
	.home-crosslinks strong { font-size: 22px; }
	.home-crosslinks p { margin-top: 4px; font-size: 14px; }
	.home-crosslinks a:last-child { background: var(--brand-wine); }
	.home-crosslinks a:last-child p { color: var(--on-wine); }
	@media (max-width: 920px) {
		.home-project { grid-template-columns: minmax(90px, 1fr) minmax(0, 3fr) minmax(100px, 1.5fr) 24px; }
		.home-journal { gap: 28px; }
	}
	@media (max-width: 720px) {
		.home-intro { grid-template-columns: 1fr 1fr; gap: 24px 12px; padding: 24px 0; }
		.hero-number { font-size: clamp(130px, 44vw, 300px); }
		.hero-portrait { grid-area: 2 / 1 / 3 / -1; width: min(55%, 275px); margin-top: -24px; }
		.hero-message { grid-area: 3 / 1; }
		.hero-actions { grid-area: 3 / 2; }
		.hero-message, .hero-actions { margin: 0; }
		.hero-message h1 { font-size: clamp(1.75rem, 5.7vw, 2.75rem); }
		.workflow-card, .home-journal { grid-template-columns: 1fr; gap: 22px; }
		.process-grid, .home-numbers dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.career-grid, .home-craft { grid-template-columns: 1fr; }
		.craft-feature { grid-row: auto; }
	}
	@media (max-width: 460px) {
		.home-intro { grid-template-columns: 1fr; }
		.hero-message { grid-area: 3 / 1; }
		.hero-actions { grid-area: 4 / 1; }
		.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; text-align: left; }
		.hero-actions p { width: 100%; }
		.hero-portrait { width: min(57%, 240px); }
		.brand-strip ul { justify-content: flex-start; font-size: 15px; padding: 16px 0; }
		.strength-pair { grid-template-columns: 1fr; }
		.home-project { grid-template-columns: 70px minmax(0, 1fr) 22px; padding: 18px 0; }
		.home-project img { grid-column: 2; grid-row: 2; height: auto; aspect-ratio: 2.4; }
		.project-arrow { grid-column: 3; grid-row: 1; }
		.project-metric strong { font-size: 1.75rem; }
		.home-journal li a { font-size: 18px; }
	}
</style>
