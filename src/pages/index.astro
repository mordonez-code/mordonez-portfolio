---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [projects, blogPosts, journalEntries] = await Promise.all([
  getCollection('work', ({ data }) => !data.draft),
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('journal', ({ data }) => !data.draft),
]);

const selectedWork = projects.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestWriting = [...blogPosts, ...journalEntries]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const linkedin =
  'https://www.linkedin.com/in/marianaordonezalarcon/';
---

<BaseLayout
  title="Mariana Ordonez — AI & E-commerce Product Designer"
  description="Product designer designing AI-powered e-commerce experiences — the Ferrero digital shelf across Amazon, Walmart & more. Selected work and field notes."
>
  <section class="hero" aria-labelledby="intro-heading">
    <div class="hero__content">
      <p class="eyebrow">AI &amp; E-commerce Product Designer</p>
      <h1 id="intro-heading">Mariana Ordonez</h1>
      <p class="lede">
        I design AI-powered e-commerce experiences. For 8 years I've designed for commerce —
        today that's the digital shelf for global brands, including Ferrero (Nutella, Kinder,
        Ferrero Rocher) across Amazon, Walmart and more — and I build AI into how that work gets made. I also
        designed, coded and run my own Shopify store,
        {' '}<a href="https://tienda.mordonez.com" target="_blank" rel="noopener">tienda.mordonez.com</a>.
      </p>
      <div class="hero__actions" aria-label="Primary sections">
        <a href="/work/">See selected work</a>
        <a href={linkedin} target="_blank" rel="noopener">Get in touch</a>
      </div>
    </div>
  </section>

  <main>
    <section class="section-grid" aria-labelledby="what-i-do-heading">
      <div>
        <p class="eyebrow">What I do</p>
        <h2 id="what-i-do-heading">Designing where e-commerce, content, and AI meet.</h2>
      </div>
      <div class="feature-grid">
        <article>
          <h3>AI experience design</h3>
          <p>Conversational and copilot interfaces, and systems where people need to understand, trust, and act on AI-generated output.</p>
        </article>
        <article>
          <h3>AI-integrated content</h3>
          <p>Building generative AI into creative workflows to ship faster and at higher volume without losing brand craft.</p>
        </article>
        <article>
          <h3>Digital shelf &amp; DTC commerce</h3>
          <p>Product pages, A+ content, and brand stores for global brands across Amazon, Walmart, Target, Kroger, Instacart and more — plus Shopify stores designed and built end to end.</p>
        </article>
      </div>
    </section>

    <section class="writing-list" aria-labelledby="work-heading">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">Case studies</h2>
      </div>
      <div class="post-list">
        {
          selectedWork.map((project) => (
            <article>
              <a href={`/work/${project.id}/`}>
                {project.data.role && <span>{project.data.role}</span>}
                <h3>{project.data.title}</h3>
                <p>{project.data.summary ?? project.data.description}</p>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="writing-list" aria-labelledby="latest-heading">
      <div class="section-heading">
        <p class="eyebrow">Latest</p>
        <h2 id="latest-heading">Recent writing</h2>
      </div>
      <div class="post-list">
        {
          latestWriting.map((entry) => (
            <article>
              <a href={`/${entry.collection}/${entry.id}/`}>
                <span>{entry.collection}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <time datetime={entry.data.pubDate.toISOString()}>
                  {entry.data.pubDate.toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-grid" aria-labelledby="contact-heading">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Open to remote product &amp; AI design roles.</h2>
      </div>
      <div class="feature-grid">
        <article>
          <h3>Get in touch</h3>
          <p>
            <a href="mailto:marianaordonez04@gmail.com">marianaordonez04@gmail.com</a>
            {' '}— or find me on{' '}
            <a href={linkedin} target="_blank" rel="noopener">LinkedIn</a>.
          </p>
          <p>
            <a href="/Mariana-Ordonez-CV.pdf" target="_blank" rel="noopener">View CV (PDF)</a>
          </p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
