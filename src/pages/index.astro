---
import Layout from "../layouts/Layout.astro";
import { caseStudies, proofBrands, site } from "../data/site";
import { getJournalArticles } from "../lib/journal.server";

const featuredWork = caseStudies.filter((item) => item.featured).slice(0, 3);
const [primaryWork, ...secondaryWork] = featuredWork;
const primaryMedia = primaryWork as { cover?: string; coverPosition?: string };
const articles = await getJournalArticles();
const journalOrder = [
	"ai-ab-tests-faster-design-craft",
	"trustworthy-ai-interfaces",
	"high-converting-product-detail-page",
];
const featuredArticles = journalOrder
	.map((slug) => articles.find((article) => article.slug === slug))
	.filter(Boolean);
---

<Layout
	title="Mariana Ordoñez · Ecommerce Graphic Designer"
	description="Agentic Product & AI UX Designer. AI-native workflow in Figma and Claude Code, end-to-end product and design systems, with 6+ years of conversion-driven commerce. Remote, US hours."
	path="/"
>
	<main id="top">
		<section class="container hero home-hero">
			<div class="hero-copy">
				<p class="eyebrow"><span class="dot" aria-hidden="true"></span>Open to work - US hours - Colombia</p>
				<p class="script">Hi, I'm Mariana -</p>
				<h1>I design products people <span class="ink-swoop">actually</span> use.</h1>
				<p class="hero-lede">
					I am an <strong>Agentic Product & AI UX Designer</strong>. I work AI-native - designing
					end-to-end in Figma and moving fast in AI-assisted environments like Claude Code - with 6+
					years of conversion-driven commerce as the proof. Remote, live in US hours.
				</p>
				<div class="actions">
					<a class="button" href="#work">See selected work <span aria-hidden="true">-></span></a>
					<a class="text-link" href="/about/">Read my story</a>
				</div>
			</div>

			<div class="hero-visual hero-visual-source">
				<svg
					class="hero-card"
					viewBox="-1 0 442 607"
					xmlns="http://www.w3.org/2000/svg"
					role="img"
					aria-label="Portrait of Mariana Ordonez with a handwritten note reading: your next designer"
				>
					<defs>
						<clipPath id="heroPhotoClip">
							<rect x="67" y="60" width="306" height="383" rx="28" />
						</clipPath>
					</defs>
					<!-- layered shadow card -->
					<rect x="10.8" y="23.7" width="418.7" height="573.2" rx="20" fill="#e7d3d4" transform="rotate(-2.18 220.1 310.3)" />
					<!-- pink mount -->
					<rect x="25" y="25" width="389" height="454" rx="20" fill="#ffeaeb" />
					<!-- dashed border -->
					<rect x="41" y="42" width="357" height="419" rx="20" fill="none" stroke="#ca9ba1" stroke-width="1" stroke-dasharray="4 4" />
					<!-- portrait -->
					<image href="/brand/mariana-portrait.webp" x="67" y="60" width="306" height="383" preserveAspectRatio="xMidYMin slice" clip-path="url(#heroPhotoClip)" />
					<!-- caption -->
					<text x="220" y="533" text-anchor="middle" fill="#832131" font-family="Newsreader, Georgia, serif" font-style="italic" font-weight="500" font-size="25.42">your next designer!</text>
					<!-- arrow (moa-arrow-wine, rotated to point at the caption) -->
					<g transform="translate(372 488) rotate(146.57 29 29) scale(0.97)" fill="none" stroke="#832131" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 50 C 8 18, 30 8, 52 14" />
						<path d="M44 9 L 54 14 L 46 22" />
					</g>
				</svg>
			</div>
		</section>

		<section class="container proof-band" aria-label="Brands and teams">
			<div class="proof-top">
				<p class="kicker">Brands and teams I have designed conversion for</p>
			</div>
			<div class="marquee" aria-hidden="true">
				<div class="marquee-track">
					{
						[0, 1].map(() => (
							<div class="marquee-group">
								{proofBrands.map((brand) => (
									<>
										<span>{brand}</span>
										<i></i>
									</>
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="container section home-capabilities" id="capabilities">
			<div class="section-head compact-head">
				<div>
					<p class="kicker">What I do</p>
					<h2 class="section-title">Three things I am genuinely good at.</h2>
					<p class="section-copy">
						AI is my method, conversion is the outcome. Here is what that looks like in practice.
					</p>
				</div>
			</div>

			<div class="capability-row">
				<div class="capability-copy">
					<p class="kicker">01 - Agentic product design</p>
					<h3>Agentic UX people actually trust.</h3>
					<p>
						I design agentic products with the emerging language of AI UX - wayfinders to get
						people started, governors to keep a human in control, trust builders to keep it
						honest - and I build it the AI-native way, in Figma and Claude Code.
					</p>
					<div class="bullet-tags">
						<span>Agentic UX patterns</span>
						<span>Human-AI interaction</span>
						<span>AI-native in Claude Code</span>
					</div>
				</div>
				<div class="mock-panel">
					<div class="mock-window">
						<div class="mock-head">
							<span class="mock-icon">AI</span>
							<strong>AI UX patterns</strong>
							<small>the shape of agentic UX</small>
						</div>
						<div class="mock-body">
							<div class="pattern-grid">
								<div class="pattern-tile"><strong>Wayfinders</strong><span>Help people start and find their way in.</span></div>
								<div class="pattern-tile"><strong>Inputs</strong><span>Ways to direct the AI to act.</span></div>
								<div class="pattern-tile"><strong>Tuners</strong><span>Refine context, tone and limits.</span></div>
								<div class="pattern-tile"><strong>Governors</strong><span>Keep a human in the loop.</span></div>
								<div class="pattern-tile"><strong>Trust builders</strong><span>Make results honest and legible.</span></div>
								<div class="pattern-tile"><strong>Identifiers</strong><span>Give the AI an on-brand identity.</span></div>
							</div>
							<p class="pattern-credit">Framework: The Shape of AI</p>
						</div>
					</div>
				</div>
			</div>

			<div class="capability-row flip">
				<div class="mock-panel">
					<div class="mock-window">
						<div class="mock-head">
							<span class="dot" aria-hidden="true"></span>
							<strong>A/B test - PDP hero</strong>
							<small>last 14 days</small>
						</div>
						<div class="mock-body">
							<div class="ab-variants">
								<figure class="ab-variant">
									<img src="/mockups/ecommerce-ab-a.webp" alt="PDP hero variant A: Butterfinger Unwrapped Minis" width="480" height="480" loading="lazy" />
									<figcaption>Variant A</figcaption>
								</figure>
								<figure class="ab-variant is-winner">
									<span class="ab-tag">Winner</span>
									<img src="/mockups/ecommerce-ab-b.webp" alt="PDP hero variant B: Butterfinger Unwrapped Minis" width="480" height="480" loading="lazy" />
									<figcaption>Variant B</figcaption>
								</figure>
							</div>
							<div class="metric-row">
								<div>
									<span>Checkout conversion</span>
									<strong>3.9%</strong>
								</div>
								<em>+18% vs. A</em>
							</div>
							<div class="demo-row mini"><span>A</span><div class="bar"><span style="width: 58%"></span></div></div>
							<div class="demo-row mini"><span>B</span><div class="bar"><span style="width: 74%"></span></div></div>
						</div>
					</div>
				</div>
				<div class="capability-copy">
					<p class="kicker">02 - eCommerce & CRO</p>
					<h3>Pages that move the number.</h3>
					<p>
						I ship competing PDP, landing-page and checkout variants, then let real shopper
						behavior pick the winner. A/B testing turns opinions into evidence, so every change is
						tied to conversion instead of a hunch.
					</p>
					<div class="bullet-tags">
						<span>PDPs and landing pages</span>
						<span>A/B testing</span>
						<span>AOV and funnels</span>
					</div>
				</div>
			</div>

			<div class="capability-row">
				<div class="capability-copy">
					<p class="kicker">03 - Design systems & brand</p>
					<h3>One system, every screen on-brand.</h3>
					<p>
						Scalable Figma systems and tokens keep brand and components consistent through a
						hundred experiments, and keep engineers shipping fast.
					</p>
					<div class="bullet-tags">
						<span>Figma systems</span>
						<span>Design tokens</span>
						<span>Visual identity</span>
					</div>
				</div>
				<div class="mock-panel">
					<div class="mock-window">
						<div class="mock-head">
							<span class="mock-icon">DS</span>
							<strong>Design system</strong>
							<small>tokens</small>
						</div>
						<div class="ds-shot">
							<img src="/mockups/design-system.webp" alt="Design system documentation: content color tokens with names, roles, token variables and parent color references" width="1000" height="1260" loading="lazy" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="container section selected-work-source" id="work">
			<div class="section-head">
				<div>
					<p class="kicker">Selected work</p>
					<h2 class="section-title">Selected work</h2>
					<p class="section-copy">
						Each one is a real case study with the messy middle left in: variants, tradeoffs and
						metrics after launch.
					</p>
				</div>
				<a class="text-link" href="/work/">All work -></a>
			</div>

			<a class="card work-feature-card" href={`/work/${primaryWork.slug}/`}>
				<div class={`work-cover${primaryMedia.cover ? " has-cover" : ""}`} aria-hidden="true">
					{primaryMedia.cover && <img src={primaryMedia.cover} alt="" loading="lazy" style={`object-position: ${primaryMedia.coverPosition ?? "center"}`} />}
				</div>
				<div class="work-copy">
					<p class="kicker">Featured - {primaryWork.client} - {primaryWork.period}</p>
					<h3>{primaryWork.outcome}</h3>
					<p>{primaryWork.summary}</p>
					<div class="work-card-foot">
						<div class="tags">
							{primaryWork.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
						</div>
						<span class="metric">View case study -></span>
					</div>
				</div>
			</a>

			<div class="grid-2 work-pair">
				{
					secondaryWork.map((study) => {
						const m = study as { cover?: string; coverPosition?: string };
						return (
						<a class="card work-mini-card" href={`/work/${study.slug}/`}>
							<div class={`work-cover compact${m.cover ? " has-cover" : ""}`} aria-hidden="true">
								{m.cover && <img src={m.cover} alt="" loading="lazy" style={`object-position: ${m.coverPosition ?? "center"}`} />}
							</div>
							<div class="work-copy">
								<p class="kicker">{study.client} - {study.period}</p>
								<h3>{study.outcome}</h3>
								<p>{study.summary}</p>
								<div class="impact-badge small">
									<span>{study.impact}</span>
								</div>
								<div class="work-card-foot">
									<div class="tags">
										{study.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
									</div>
									<span class="metric">View -></span>
								</div>
							</div>
						</a>
						);
					})
				}
			</div>
		</section>

		<section class="container section now-section">
			<div>
				<p class="kicker">Right now</p>
				<h2 class="section-title">This season, I am...</h2>
				<div class="now-list">
					<p><strong>Designing</strong><span>PDPs for the next retail season, ahead of the product drops.</span></p>
					<p><strong>Testing</strong><span>Last season's PDPs against fresh variants to see what actually moved.</span></p>
					<p><strong>Learning</strong><span>Sharper ways to pair AI speed with design taste.</span></p>
				</div>
			</div>
			<div class="stats-grid">
				<div><strong>6+</strong><span>Years shipping conversion</span></div>
				<div><strong>12+</strong><span>Consumer brands designed for</span></div>
				<div><strong>EN / ES</strong><span>Bilingual - live US hours</span></div>
				<div><strong>IBM</strong><span>Gen AI for UX cert</span></div>
			</div>
		</section>

		<section class="container section tight">
			<div class="section-head">
				<div>
					<p class="kicker">From the journal</p>
					<h2 class="section-title">From the journal</h2>
					<p class="section-copy">
						A working notebook: mostly product design, conversion and AI, written down before I
						lose it.
					</p>
				</div>
				<a class="text-link" href="/journal/">Read all -></a>
			</div>
			<div class="grid-3">
				{
					featuredArticles.map((article) => (
						<a class="card" href={`/journal/${article.slug}/`}>
							<p class="kicker">{article.category}</p>
							<h3>{article.title}</h3>
							<p>{article.excerpt}</p>
							<span class="metric">Read -></span>
						</a>
					))
				}
			</div>
		</section>

		<section class="container cta-band home-cta" id="contact">
			<p class="kicker">Let's work together</p>
			<h2>Looking for a designer who ships conversion and speaks AI?</h2>
			<p>I am open to remote product, UX and eCommerce roles, working US hours from Colombia.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href={site.resumeUrl}>Download resume</a>
			</div>
			<div class="cta-meta">
				<div><strong>Where</strong><span>Bogota, Colombia - remote, US hours</span></div>
				<div><strong>Response</strong><span>Usually within 24 hours</span></div>
			</div>
		</section>
	</main>
</Layout>
